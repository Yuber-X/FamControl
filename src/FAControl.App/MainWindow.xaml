<Window x:Class="FAControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FAControl.ViewModels;assembly=FAControl.ViewModels"
        xmlns:views="clr-namespace:FAControl.Views;assembly=FAControl.Views"
        Title="FAControl — Gestión de préstamos"
        Width="1280" Height="760"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.FondoApp}">

  <!-- Raiz: recibe el LayoutTransform del tamaño de texto (Configuración) -->
  <Grid x:Name="Raiz">
    <Grid.ColumnDefinitions>
      <!-- Sidebar fijo de 240px — DESIGN.md §9 -->
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============ SIDEBAR ============ -->
    <Border Grid.Column="0" Background="{DynamicResource Brush.FondoCard}"
            BorderBrush="{DynamicResource Brush.BordeSutil}" BorderThickness="0,0,0.5,0">
      <DockPanel>

        <!-- Marca del MODO activo: el color lo pone MostrarModo() según el
             modo elegido en el launcher, para que se vea de un vistazo
             dónde está parado el usuario -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,20,24">
          <Border x:Name="MarcaModo" Width="30" Height="30" CornerRadius="8"
                  Background="{DynamicResource Brush.Primario}">
            <views:LogoFA Width="20" Height="20"
                          ColorF="White" ColorA="White" ColorVentana="Transparent" />
          </Border>
          <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
            <TextBlock x:Name="NombreModo" Text="FAControl"
                       Style="{DynamicResource Texto.Titulo3}" />
            <TextBlock x:Name="EtiquetaModo" Text="Familia Almonte"
                       Style="{DynamicResource Texto.Caption}" />
          </StackPanel>
        </StackPanel>

        <!-- Usuario + salir (pie del sidebar) -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.BordeSutil}"
                BorderThickness="0,0.5,0,0" Padding="20,14">
          <DockPanel>
            <!-- Template circular compartido por los dos botones del pie
                 (pedido de Yuber 2026-07-10, punto 10) -->
            <DockPanel.Resources>
              <ControlTemplate x:Key="BotonCircular" TargetType="Button">
                <Border x:Name="Fondo" CornerRadius="14" Background="Transparent">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Fondo" Property="Background"
                            Value="{DynamicResource Brush.PrimarioSutil}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Primario}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </DockPanel.Resources>

            <!-- Cerrar sesión: vuelve al LAUNCHER -->
            <Button DockPanel.Dock="Right" Content="⏻" FontSize="14" Width="28" Height="28"
                    Cursor="Hand" Foreground="{DynamicResource Brush.TextoTerciario}"
                    Template="{StaticResource BotonCircular}"
                    ToolTip="Cerrar sesión y volver al inicio" Click="BotonSalir_Click" />

            <!-- Cambiar usuario: vuelve al LOGIN de este mismo modo, para el
                 relevo de turno (pedido de Yuber 2026-07-17) -->
            <Button DockPanel.Dock="Right" Content="&#xE748;" FontFamily="Segoe MDL2 Assets"
                    FontSize="13" Width="28" Height="28" Margin="0,0,4,0"
                    Cursor="Hand" Foreground="{DynamicResource Brush.TextoTerciario}"
                    Template="{StaticResource BotonCircular}"
                    ToolTip="Cambiar de usuario" Click="BotonCambiarUsuario_Click" />
            <Border Width="32" Height="32" CornerRadius="16"
                    Background="{DynamicResource Brush.PrimarioSutil}">
              <TextBlock Text="{Binding Iniciales}" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Primario}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
              <TextBlock Text="{Binding NombreUsuario}" Style="{DynamicResource Texto.CuerpoEnfatizado}" />
              <!-- Multiusuario: se muestra el ROL del empleado activo -->
              <TextBlock Text="{Binding RolUsuario}" Style="{DynamicResource Texto.Caption}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Navegación: IsChecked refleja PaginaActual (la navegación interna,
             p.ej. crear préstamo → detalle, también actualiza el sidebar) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="MENÚ PRINCIPAL" Style="{DynamicResource Texto.MicroLabel}"
                     Margin="24,0,0,8" />
          <RadioButton Content="Panel" Tag="&#xE80F;" Style="{DynamicResource Sidebar.Item}"
                       Visibility="{Binding PuedeVerPanel, Converter={StaticResource BoolAVisibilidad}}"
                       IsChecked="{Binding PaginaActual, Mode=OneWay,
                                   Converter={StaticResource Igualdad},
                                   ConverterParameter={x:Static vm:Pagina.Panel}}"
                       Command="{Binding NavegarCommand}"
                       CommandParameter="{x:Static vm:Pagina.Panel}" />
          <RadioButton Content="Clientes" Tag="&#xE716;" Style="{DynamicResource Sidebar.Item}"
                       Visibility="{Binding PuedeVerClientes, Converter={StaticResource BoolAVisibilidad}}"
                       IsChecked="{Binding PaginaActual, Mode=OneWay,
                                   Converter={StaticResource Igualdad},
                                   ConverterParameter={x:Static vm:Pagina.Clientes}}"
                       Command="{Binding NavegarCommand}"
                       CommandParameter="{x:Static vm:Pagina.Clientes}" />
          <RadioButton Content="Préstamos" Tag="&#xE825;" Style="{DynamicResource Sidebar.Item}"
                       Visibility="{Binding PuedeVerPrestamos, Converter={StaticResource BoolAVisibilidad}}"
                       IsChecked="{Binding PaginaActual, Mode=OneWay,
                                   Converter={StaticResource Igualdad},
                                   ConverterParameter={x:Static vm:Pagina.Prestamos}}"
                       Command="{Binding NavegarCommand}"
                       CommandParameter="{x:Static vm:Pagina.Prestamos}" />
          <RadioButton Content="Nuevo préstamo" Tag="&#xE710;" Style="{DynamicResource Sidebar.Item}"
                       Visibility="{Binding PuedeVerNuevoPrestamo, Converter={StaticResource BoolAVisibilidad}}"
                       IsChecked="{Binding PaginaActual, Mode=OneWay,
                                   Converter={StaticResource Igualdad},
                                   ConverterParameter={x:Static vm:Pagina.NuevoPrestamo}}"
                       Command="{Binding NavegarCommand}"
                       CommandParameter="{x:Static vm:Pagina.NuevoPrestamo}" />
          <!-- AutoControl: mismas páginas de préstamo, con otra etiqueta -->
          <RadioButton Content="Ventas financiadas" Tag="&#xE825;" Style="{DynamicResource Sidebar.Item}"
                       Visibility="{Binding PuedeVerVentasFinanciadas, Converter={StaticResource BoolAVisibilidad}}"
                       IsChecked="{Binding PaginaActual, Mode=OneWay,
                                   Converter={StaticResource Igualdad},
                                   ConverterParameter={x:Static vm:Pagina.Prestamos}}"
                       Command="{Binding NavegarCommand}"
                       CommandParameter="{x:Static vm:Pagina.Prestamos}" />
          <RadioButton Content="Nueva venta financiada" Tag="&#xE710;" Style="{DynamicResource Sidebar.Item}"
                       Visibility="{Binding PuedeVerNuevaVentaFinanciada, Converter={StaticResource BoolAVisibilidad}}"
                       IsChecked="{Binding PaginaActual, Mode=OneWay,
                                   Converter={StaticResource Igualdad},
                                   ConverterParameter={x:Static vm:Pagina.NuevoPrestamo}}"
                       Command="{Binding NavegarCommand}"
                       CommandParameter="{x:Static vm:Pagina.NuevoPrestamo}" />
          <RadioButton Content="Cobros" Tag="&#xE8EF;" Style="{DynamicResource Sidebar.Item}"
                       Visibility="{Binding PuedeVerCobros, Converter={StaticResource BoolAVisibilidad}}"
                       IsChecked="{Binding PaginaActual, Mode=OneWay,
                                   Converter={StaticResource Igualdad},
                                   ConverterParameter={x:Static vm:Pagina.Cobros}}"
                       Command="{Binding NavegarCommand}"
                       CommandParameter="{x:Static vm:Pagina.Cobros}" />
          <RadioButton Content="Contratos" Tag="&#xE8A5;" Style="{DynamicResource Sidebar.Item}"
                       Visibility="{Binding PuedeVerContratos, Converter={StaticResource BoolAVisibilidad}}"
                       IsChecked="{Binding PaginaActual, Mode=OneWay,
                                   Converter={StaticResource Igualdad},
                                   ConverterParameter={x:Static vm:Pagina.Contratos}}"
                       Command="{Binding NavegarCommand}"
                       CommandParameter="{x:Static vm:Pagina.Contratos}" />
          <RadioButton Content="Reportes" Tag="&#xE9D2;" Style="{DynamicResource Sidebar.Item}"
                       Visibility="{Binding PuedeVerReportes, Converter={StaticResource BoolAVisibilidad}}"
                       IsChecked="{Binding PaginaActual, Mode=OneWay,
                                   Converter={StaticResource Igualdad},
                                   ConverterParameter={x:Static vm:Pagina.Reportes}}"
                       Command="{Binding NavegarCommand}"
                       CommandParameter="{x:Static vm:Pagina.Reportes}" />
          <RadioButton Content="Vehículos" Tag="&#xE804;" Style="{DynamicResource Sidebar.Item}"
                       Visibility="{Binding PuedeVerVehiculos, Converter={StaticResource BoolAVisibilidad}}"
                       IsChecked="{Binding PaginaActual, Mode=OneWay,
                                   Converter={StaticResource Igualdad},
                                   ConverterParameter={x:Static vm:Pagina.Vehiculos}}"
                       Command="{Binding NavegarCommand}"
                       CommandParameter="{x:Static vm:Pagina.Vehiculos}" />
          <RadioButton Content="Ventas al contado" Tag="&#xE7BF;" Style="{DynamicResource Sidebar.Item}"
                       Visibility="{Binding PuedeVerVentas, Converter={StaticResource BoolAVisibilidad}}"
                       IsChecked="{Binding PaginaActual, Mode=OneWay,
                                   Converter={StaticResource Igualdad},
                                   ConverterParameter={x:Static vm:Pagina.Ventas}}"
                       Command="{Binding NavegarCommand}"
                       CommandParameter="{x:Static vm:Pagina.Ventas}" />
          <RadioButton Content="Alquileres" Tag="&#xE8C7;" Style="{DynamicResource Sidebar.Item}"
                       Visibility="{Binding PuedeVerAlquileres, Converter={StaticResource BoolAVisibilidad}}"
                       IsChecked="{Binding PaginaActual, Mode=OneWay,
                                   Converter={StaticResource Igualdad},
                                   ConverterParameter={x:Static vm:Pagina.Alquileres}}"
                       Command="{Binding NavegarCommand}"
                       CommandParameter="{x:Static vm:Pagina.Alquileres}" />
          <RadioButton Content="Importación / gastos" Tag="&#xE7BE;" Style="{DynamicResource Sidebar.Item}"
                       Visibility="{Binding PuedeVerGastos, Converter={StaticResource BoolAVisibilidad}}"
                       IsChecked="{Binding PaginaActual, Mode=OneWay,
                                   Converter={StaticResource Igualdad},
                                   ConverterParameter={x:Static vm:Pagina.Gastos}}"
                       Command="{Binding NavegarCommand}"
                       CommandParameter="{x:Static vm:Pagina.Gastos}" />
          <RadioButton Content="Historial" Tag="&#xE81C;" Style="{DynamicResource Sidebar.Item}"
                       Visibility="{Binding PuedeVerHistorial, Converter={StaticResource BoolAVisibilidad}}"
                       IsChecked="{Binding PaginaActual, Mode=OneWay,
                                   Converter={StaticResource Igualdad},
                                   ConverterParameter={x:Static vm:Pagina.Historial}}"
                       Command="{Binding NavegarCommand}"
                       CommandParameter="{x:Static vm:Pagina.Historial}" />
          <RadioButton Content="Usuarios" Tag="&#xE77B;" Style="{DynamicResource Sidebar.Item}"
                       Visibility="{Binding PuedeVerUsuarios, Converter={StaticResource BoolAVisibilidad}}"
                       IsChecked="{Binding PaginaActual, Mode=OneWay,
                                   Converter={StaticResource Igualdad},
                                   ConverterParameter={x:Static vm:Pagina.Usuarios}}"
                       Command="{Binding NavegarCommand}"
                       CommandParameter="{x:Static vm:Pagina.Usuarios}" />
          <RadioButton Content="Configuración" Tag="&#xE713;" Style="{DynamicResource Sidebar.Item}"
                       Visibility="{Binding PuedeVerConfiguracion, Converter={StaticResource BoolAVisibilidad}}"
                       IsChecked="{Binding PaginaActual, Mode=OneWay,
                                   Converter={StaticResource Igualdad},
                                   ConverterParameter={x:Static vm:Pagina.Configuracion}}"
                       Command="{Binding NavegarCommand}"
                       CommandParameter="{x:Static vm:Pagina.Configuracion}" />
        </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ============ ÁREA PRINCIPAL ============ -->
    <Grid Grid.Column="1" Margin="32">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="{Binding TituloPagina}"
                 Style="{DynamicResource Texto.Titulo1}" Margin="0,0,0,20" />

      <!-- Página activa: el DataTemplate global (App.xaml) resuelve la View -->
      <ContentControl Grid.Row="1" Content="{Binding PaginaActualVm}" Focusable="False" />
    </Grid>
  </Grid>
</Window>
