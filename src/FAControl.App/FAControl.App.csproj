<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FAControl.Views\FAControl.Views.csproj" />
    <ProjectReference Include="..\FAControl.ViewModels\FAControl.ViewModels.csproj" />
    <ProjectReference Include="..\FAControl.Services\FAControl.Services.csproj" />
    <ProjectReference Include="..\FAControl.Data\FAControl.Data.csproj" />
    <ProjectReference Include="..\FAControl.Common\FAControl.Common.csproj" />
    <ProjectReference Include="..\FAControl.Printing\FAControl.Printing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Ícono del ejecutable (Explorer, barra de tareas, ventanas) -->
    <ApplicationIcon>Assets\facontrol.ico</ApplicationIcon>
    <!-- La ventana de Ayuda muestra esta versión, y Windows la usa en las
         propiedades del .exe. Mantenerla igual a AppVersion del instalador. -->
    <Version>1.7.0</Version>
    <Company>Yuber Santana</Company>
    <Product>FAControl</Product>
  </PropertyGroup>

</Project>
