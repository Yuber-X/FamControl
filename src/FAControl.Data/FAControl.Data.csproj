<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FAControl.Models\FAControl.Models.csproj" />
    <ProjectReference Include="..\FAControl.Common\FAControl.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Esquema embebido para el auto-aprovisionamiento del primer arranque.
         Única fuente de verdad: el mismo archivo de scripts/db/. -->
    <EmbeddedResource Include="..\..\scripts\db\001_create_schema.sql"
                      Link="001_create_schema.sql"
                      LogicalName="FAControl.Data.001_create_schema.sql" />

    <!-- Migraciones embebidas: la app pone la base al día sola al arrancar
         (MigradorEsquema). Es lo que permite ACTUALIZAR sin reinstalar ni
         correr aplicar.ps1 a mano en la PC del cliente.
         Quedan afuera a propósito: 001 (va arriba, esquema completo),
         002 y seed_* (datos de prueba) y 999_rollback (BORRA la base). -->
    <EmbeddedResource Include="..\..\scripts\db\0*.sql"
                      Exclude="..\..\scripts\db\001_create_schema.sql;..\..\scripts\db\002_seed_data.sql;..\..\scripts\db\999_rollback.sql;..\..\scripts\db\seed_*.sql"
                      Link="migraciones\%(Filename)%(Extension)"
                      LogicalName="FAControl.Data.migraciones.%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FAControl.Data.Tests" />
  </ItemGroup>

</Project>
