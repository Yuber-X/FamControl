<UserControl x:Class="FAControl.Views.VentaFinanciamientoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
    <StackPanel MaxWidth="1000" HorizontalAlignment="Left">

      <!-- Encabezado -->
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="← Volver" Style="{DynamicResource Boton.Terciario}"
                Command="{Binding VolverCommand}" />
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Style="{DynamicResource Texto.Titulo2}">
            <Run Text="{Binding Codigo, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TipoTexto, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Style="{DynamicResource Texto.Caption}">
            <Run Text="{Binding ClienteNombre, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding VehiculoDescripcion, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Content="Carta de compromiso" Style="{DynamicResource Boton.Secundario}"
                  Visibility="{Binding EsPlazos, Converter={StaticResource BoolAVisibilidad}}"
                  Command="{Binding VerCartaCommand}" />
          <Button Content="Recibo de separación" Style="{DynamicResource Boton.Secundario}"
                  Margin="8,0,0,0"
                  Visibility="{Binding EsSeparacion, Converter={StaticResource BoolAVisibilidad}}"
                  Command="{Binding VerReciboSeparacionCommand}" />
        </StackPanel>
      </Grid>

      <!-- Aviso (separación por vencer/vencida, plazos atrasados, saldada) -->
      <Border Background="#1AF59E0B" CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
              Visibility="{Binding HayAviso, Converter={StaticResource BoolAVisibilidad}}">
        <TextBlock Text="{Binding AvisoTexto}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
      </Border>

      <!-- Los 4 números en el orden que pidió el cliente:
           total por pagar > pendiente > cantidad de plazos > pagado -->
      <UniformGrid Rows="1" Columns="4" Margin="0,0,0,12">
        <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0"
                Background="{DynamicResource Brush.Primario}">
          <StackPanel>
            <TextBlock Text="TOTAL POR PAGAR" Style="{DynamicResource Texto.MicroLabel}" Foreground="#C7CBFB" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding TotalAPagar, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Display}" Foreground="White" />
            </Viewbox>
            <TextBlock Style="{DynamicResource Texto.Caption}" Foreground="#C7CBFB">
              <Run Text="Precio " /><Run Text="{Binding Precio, Converter={StaticResource Money}, Mode=OneWay}" />
              <Run Text=" · inicial " /><Run Text="{Binding Inicial, Converter={StaticResource Money}, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="LO PENDIENTE" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding Pendiente, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Display}" />
            </Viewbox>
            <TextBlock Text="Falta por cobrar" Style="{DynamicResource Texto.Caption}" />
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="PLAZOS" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding Plazos.Count}" Style="{DynamicResource Texto.Display}" />
            </Viewbox>
            <TextBlock Text="{Binding PlazosTexto}" Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Card.Metrica}">
          <StackPanel>
            <TextBlock Text="LO PAGADO" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding Pagado, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Display}" />
            </Viewbox>
            <TextBlock Text="Abonado a los plazos" Style="{DynamicResource Texto.Caption}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Calendario de plazos + cobro -->
      <Border Style="{DynamicResource Card}" Padding="20,14" Margin="0,0,0,12"
              Visibility="{Binding EsPlazos, Converter={StaticResource BoolAVisibilidad}}">
        <StackPanel>
          <TextBlock Text="Calendario de plazos" Style="{DynamicResource Texto.Titulo3}" Margin="0,0,0,10" />

          <DataGrid Style="{DynamicResource Tabla}" ItemsSource="{Binding Plazos}"
                    SelectedItem="{Binding PlazoSeleccionado}"
                    AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                    MaxHeight="320">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Numero}" Width="50" />
              <DataGridTextColumn Header="Vencimiento" Binding="{Binding FechaTexto}" Width="130" />
              <DataGridTextColumn Header="Monto" Width="150"
                                  Binding="{Binding Monto, Converter={StaticResource Money}}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Pagado" Width="150"
                                  Binding="{Binding MontoPagado, Converter={StaticResource Money}}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Falta" Width="150"
                                  Binding="{Binding SaldoPendiente, Converter={StaticResource Money}}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="Auto" MinWidth="110">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding EstaAtrasado}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Destructivo}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding EstaPagado}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.DeltaPositivo}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>

          <!-- Cobro del plazo seleccionado -->
          <Border Height="1" Background="{DynamicResource Brush.BordeSutil}" Margin="0,14,0,12" />
          <WrapPanel Visibility="{Binding PuedeCobrar, Converter={StaticResource BoolAVisibilidad}}">
            <StackPanel Margin="0,0,12,6">
              <TextBlock Text="Monto a cobrar" Style="{DynamicResource Input.Label}" />
              <TextBox Width="140" Height="34" Style="{DynamicResource Input.Texto}"
                       Text="{Binding MontoAbonoTexto, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,6">
              <TextBlock Text="Forma de pago" Style="{DynamicResource Input.Label}" />
              <ComboBox Width="160" Height="34" FontSize="13"
                        ItemsSource="{Binding Metodos}" SelectedItem="{Binding MetodoSeleccionado}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Texto}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Margin="0,0,12,6">
              <TextBlock Text="Referencia / nota (opcional)" Style="{DynamicResource Input.Label}" />
              <TextBox Width="260" Height="34" Style="{DynamicResource Input.Texto}"
                       Text="{Binding NotasAbono, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <Button Content="Registrar cobro" Style="{DynamicResource Boton.Primario}"
                    VerticalAlignment="Bottom" Margin="0,0,0,6"
                    Command="{Binding CobrarCommand}" />
          </WrapPanel>
          <TextBlock Text="{Binding MensajeCobro}" Foreground="{DynamicResource Brush.Destructivo}"
                     Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <!-- Historial de abonos -->
      <Border Style="{DynamicResource Card}" Padding="20,14"
              Visibility="{Binding HayAbonos, Converter={StaticResource BoolAVisibilidad}}">
        <StackPanel>
          <TextBlock Text="Abonos registrados" Style="{DynamicResource Texto.Titulo3}" Margin="0,0,0,10" />
          <DataGrid Style="{DynamicResource Tabla}" ItemsSource="{Binding Abonos}"
                    AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                    MaxHeight="260">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Recibo" Binding="{Binding NumeroRecibo}" Width="130">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{DynamicResource Fuente.Mono}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="130" />
              <DataGridTextColumn Header="Monto" Width="150"
                                  Binding="{Binding Monto, Converter={StaticResource Money}}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Forma de pago" Binding="{Binding MetodoTexto}" Width="150" />
              <DataGridTextColumn Header="Nota" Binding="{Binding NotasTexto}" Width="Auto" MinWidth="140" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <!-- ============ EXPEDIENTE DIGITAL (018, pedido 2026-07-27) ============
           Todo lo que el cliente entregó para la compra: facturas, contratos
           firmados, cédulas, fotos. Se sube de a varios, se abre con la app de
           Windows que corresponda y se baja completo en un ZIP. -->
      <Border Style="{DynamicResource Card}" Padding="20,14" Margin="0,12,0,0"
              DataContext="{Binding Expediente}">
        <StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <!-- Dos modos de ver, clickables (pedido del cliente) -->
              <RadioButton Content="Lista" GroupName="VistaExpediente" Margin="0,0,8,0"
                           VerticalAlignment="Center" FontSize="12"
                           IsChecked="{Binding VistaLista, Mode=OneWay}"
                           Command="{Binding VerEnListaCommand}" />
              <RadioButton Content="Cuadrícula" GroupName="VistaExpediente" Margin="0,0,16,0"
                           VerticalAlignment="Center" FontSize="12"
                           IsChecked="{Binding VistaCuadricula, Mode=OneWay}"
                           Command="{Binding VerEnCuadriculaCommand}" />
              <Button Content="+ Subir archivos" Style="{DynamicResource Boton.Secundario}"
                      Click="SubirDocumentos_Click" />
              <Button Content="Descargar todo (ZIP)" Style="{DynamicResource Boton.Terciario}"
                      Margin="6,0,0,0" Click="ExportarExpediente_Click" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Expediente del cliente" Style="{DynamicResource Texto.Titulo3}" />
              <TextBlock Text="{Binding ResumenTexto}" Style="{DynamicResource Texto.Caption}" />
            </StackPanel>
          </DockPanel>

          <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" Margin="0,8,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Caption}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding EsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Destructivo}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <TextBlock Margin="0,10,0,0" Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap"
                     Text="Arrancá subiendo la factura firmada, el contrato y la cédula del cliente. Doble clic sobre un documento para abrirlo, guardarlo o administrarlo."
                     Visibility="{Binding SinDocumentos, Converter={StaticResource BoolAVisibilidad}}" />

          <!-- VISTA 1: lista con nombre, tipo y fecha -->
          <DataGrid Style="{DynamicResource Tabla}" ItemsSource="{Binding Documentos}"
                    Margin="0,10,0,0" MaxHeight="300"
                    MouseDoubleClick="Documento_MouseDoubleClick"
                    Visibility="{Binding VistaLista, Converter={StaticResource BoolAVisibilidad}}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Documento" Binding="{Binding Nombre}"
                                  Width="Auto" MinWidth="240"
                                  HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
              <DataGridTextColumn Header="Tipo" Binding="{Binding Familia}" Width="120"
                                  HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
              <DataGridTextColumn Header="Tamaño" Binding="{Binding TamanoTexto}" Width="100" />
              <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="110" />
              <DataGridTextColumn Header="Subió" Binding="{Binding SubidoPorTexto}"
                                  Width="Auto" MinWidth="140"
                                  HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
              <DataGridTemplateColumn Width="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Abrir…" Style="{DynamicResource Boton.Terciario}" FontSize="11"
                            Tag="{Binding}" Click="AccionesDocumento_Click" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <!-- VISTA 2: cuadrados medianos con el ícono del tipo y el nombre -->
          <ItemsControl ItemsSource="{Binding Documentos}" Margin="0,10,0,0"
                        Visibility="{Binding VistaCuadricula, Converter={StaticResource BoolAVisibilidad}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Width="130" Height="130" Margin="0,0,10,10" Cursor="Hand"
                        Tag="{Binding}" Click="AccionesDocumento_Click"
                        ToolTip="{Binding Nombre}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Marco" CornerRadius="10" Padding="10"
                              Background="{DynamicResource Brush.FondoApp}"
                              BorderBrush="{DynamicResource Brush.BordeSutil}" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Icono}" FontFamily="Segoe MDL2 Assets"
                                     FontSize="34" HorizontalAlignment="Center"
                                     Foreground="{DynamicResource Brush.Primario}" />
                          <TextBlock Text="{Binding Nombre}" FontSize="11" Margin="0,10,0,0"
                                     TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                     MaxHeight="30"
                                     Foreground="{DynamicResource Brush.TextoPrincipal}" />
                          <TextBlock Text="{Binding FechaTexto}" FontSize="10" Margin="0,4,0,0"
                                     TextAlignment="Center"
                                     Foreground="{DynamicResource Brush.TextoTerciario}" />
                        </StackPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Marco" Property="BorderBrush"
                                  Value="{DynamicResource Brush.Primario}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
