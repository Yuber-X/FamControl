<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="clr-namespace:FAControl.Models;assembly=FAControl.Models"
                    xmlns:pos="clr-namespace:FAControl.Models.Pos;assembly=FAControl.Models"
                    xmlns:v="clr-namespace:FAControl.Views">

  <!-- ============================================================
       Botones — DESIGN.md §8: radius 8, altura 40, hover -8% luz
       ============================================================ -->
  <Style x:Key="Boton.Primario" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Brush.Primario}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Interfaz}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fondo"
                  Background="{TemplateBinding Background}"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.PrimarioHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.BordeSutil}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextoDeshabilitado}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Boton.Destructivo" TargetType="Button" BasedOn="{StaticResource Boton.Primario}">
    <Setter Property="Background" Value="{DynamicResource Brush.Destructivo}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fondo"
                  Background="{TemplateBinding Background}"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="#B91C1C" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.BordeSutil}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextoDeshabilitado}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Terciario: solo texto indigo, para acciones dentro de tablas -->
  <Style x:Key="Boton.Terciario" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Primario}" />
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Interfaz}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fondo" Background="Transparent" CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.PrimarioSutil}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Boton.Secundario" TargetType="Button" BasedOn="{StaticResource Boton.Primario}">
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Primario}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fondo"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource Brush.Primario}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.PrimarioSutil}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================
       Toggle.Segmento — selector de a varios (contratos, 2026-09-03)
       Apagado se lee como un boton secundario; encendido se pinta con el
       primario para que se vea a un metro cual esta en pantalla.
       ============================================================ -->
  <Style x:Key="Toggle.Segmento" TargetType="ToggleButton">
    <!-- Sin MinWidth ni Height fijos: estos botones se reparten el ancho de su
         contenedor, y en el panel lateral (que es angosto) un minimo los hacia
         desbordar. El alto crece si el texto tiene que partirse en dos lineas. -->
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Interfaz}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextoPrincipal}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Fondo"
                  Background="{DynamicResource Brush.FondoCard}"
                  BorderBrush="{DynamicResource Brush.BordeEstandar}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <!-- TextBlock y no ContentPresenter: TextWrapping no es propiedad
                 adjunta, asi que con un presenter el rotulo se recortaba en vez
                 de partirse. Estos botones siempre llevan texto. -->
            <TextBlock Text="{TemplateBinding Content}"
                       TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="BorderBrush"
                      Value="{DynamicResource Brush.Primario}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Fondo" Property="Background"
                      Value="{DynamicResource Brush.Primario}" />
              <Setter TargetName="Fondo" Property="BorderBrush"
                      Value="{DynamicResource Brush.Primario}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Fondo" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================
       Inputs — altura 40, borde #D4D4D3, focus indigo
       ============================================================ -->
  <Style x:Key="Input.Texto" TargetType="TextBox">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Interfaz}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextoPrincipal}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BordeEstandar}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Borde"
                  Background="{DynamicResource Brush.FondoCard}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8">
            <Grid>
              <!-- Marcador: se ve solo con el campo vacio. IsHitTestVisible=False
                   para que el clic caiga en la caja y no en el texto gris. -->
              <TextBlock x:Name="Marcador" Visibility="Collapsed"
                         Text="{Binding (v:Marcador.Texto), RelativeSource={RelativeSource TemplatedParent}}"
                         Margin="{TemplateBinding Padding}"
                         VerticalAlignment="Center"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{TemplateBinding FontSize}"
                         Foreground="{DynamicResource Brush.TextoTerciario}"
                         TextTrimming="CharacterEllipsis"
                         IsHitTestVisible="False" />
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource Brush.Primario}" />
            </Trigger>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Marcador" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Input.Password" TargetType="PasswordBox">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Interfaz}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BordeEstandar}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Borde"
                  Background="{DynamicResource Brush.FondoCard}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource Brush.Primario}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Label arriba del input, nunca al lado -->
  <Style x:Key="Input.Label" TargetType="TextBlock" BasedOn="{StaticResource Texto.Cuerpo}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextoSecundario}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <!-- ============================================================
       Card — fondo blanco, borde sutil 0.5, radius 12, sombra nivel 1
       ============================================================ -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.FondoCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BordeSutil}" />
    <Setter Property="BorderThickness" Value="0.5" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.05" Color="Black" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================
       CheckBox / RadioButton: sin estilo propio, WPF pinta el texto con
       SystemColors (oscuro fijo), y en modo noche queda negro sobre
       negro (reportado por el cliente 2026-07-17). Estos estilos
       implícitos fuerzan el texto al brush dinámico del tema.
       ============================================================ -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextoPrincipal}" />
    <Setter Property="FontFamily" Value="{DynamicResource Fuente.Interfaz}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- ============================================================
       Casilla.Moderna: la casilla de toda la vida, pero dibujada por
       nosotros (cuadrito redondeado + palomita vectorial) en vez de por
       el chrome de Windows.

       Convive con Switch.Moderno y NO lo reemplaza. La diferencia es de
       significado, no de gusto:
         · Switch  → prender o apagar un modo ("modo oscuro", "cobrar ITBIS").
         · Casilla → marcar opciones de una LISTA (los permisos por pantalla).
       Veinte interruptores uno al lado del otro en la grilla de permisos
       serian ilegibles y ocuparian el triple de ancho.

       Sigue siendo un CheckBox: IsChecked, comandos y binding no cambian.
       ============================================================ -->
  <Style x:Key="Casilla.Moderna" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextoPrincipal}" />
    <Setter Property="FontFamily" Value="{DynamicResource Fuente.Interfaz}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Caja" Width="18" Height="18" CornerRadius="5"
                    BorderThickness="1.5" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.FondoCard}"
                    BorderBrush="{DynamicResource Brush.BordeEstandar}">
              <!-- Palomita vectorial: nitida a cualquier escala y sin fuentes -->
              <Path x:Name="Palomita" Visibility="Collapsed"
                    Data="M 0,4 L 3.2,7.2 L 9,1"
                    Stroke="White" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ContentPresenter x:Name="Texto" Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              TextBlock.Foreground="{TemplateBinding Foreground}" />
          </StackPanel>

          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Caja" Property="Background"
                      Value="{DynamicResource Brush.Primario}" />
              <Setter TargetName="Caja" Property="BorderBrush"
                      Value="{DynamicResource Brush.Primario}" />
              <Setter TargetName="Palomita" Property="Visibility" Value="Visible" />
            </Trigger>
            <!-- Tercer estado (null): raya en vez de palomita -->
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Caja" Property="Background"
                      Value="{DynamicResource Brush.Primario}" />
              <Setter TargetName="Caja" Property="BorderBrush"
                      Value="{DynamicResource Brush.Primario}" />
              <Setter TargetName="Palomita" Property="Visibility" Value="Visible" />
              <Setter TargetName="Palomita" Property="Data" Value="M 0,4 L 9,4" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Caja" Property="BorderBrush"
                      Value="{DynamicResource Brush.Primario}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================
       Switch.Moderno: CheckBox con apariencia de interruptor deslizante.
       El CheckBox nativo usa el chrome de Windows — el mismo look "Windows
       Forms" que el cliente hizo cambiar en los ComboBox. Se usa donde el
       usuario ACTIVA un modo (ej. tomar el comprobante fiscal de la
       secuencia), no donde marca una opción de una lista.
       Sigue siendo un CheckBox: IsChecked, comandos y binding no cambian.
       ============================================================ -->
  <Style x:Key="Switch.Moderno" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextoPrincipal}" />
    <Setter Property="FontFamily" Value="{DynamicResource Fuente.Interfaz}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <!-- Riel -->
            <Border x:Name="Riel" Width="40" Height="22" CornerRadius="11"
                    Background="{DynamicResource Brush.BordeEstandar}"
                    VerticalAlignment="Center">
              <!-- Perilla: se desliza con el margen izquierdo -->
              <Border x:Name="Perilla" Width="16" Height="16" CornerRadius="8"
                      Background="White" HorizontalAlignment="Left"
                      Margin="3,0,0,0" VerticalAlignment="Center">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" Color="Black" />
                </Border.Effect>
              </Border>
            </Border>
            <ContentPresenter x:Name="Texto" Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              TextBlock.Foreground="{TemplateBinding Foreground}" />
          </StackPanel>

          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Riel" Property="Background"
                      Value="{DynamicResource Brush.Primario}" />
              <Setter TargetName="Perilla" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Perilla" Property="Margin" Value="0,0,3,0" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsChecked" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Riel" Property="Background"
                      Value="{DynamicResource Brush.TextoTerciario}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsChecked" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Riel" Property="Background"
                      Value="{DynamicResource Brush.PrimarioHover}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
              <Setter Property="Cursor" Value="Arrow" />
              <Setter TargetName="Texto" Property="TextBlock.Foreground"
                      Value="{DynamicResource Brush.TextoDeshabilitado}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextoPrincipal}" />
    <Setter Property="FontFamily" Value="{DynamicResource Fuente.Interfaz}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- ============================================================
       ComboBox / ComboBoxItem / DatePicker modernos: redondeados,
       texto centrado y chevron. Reemplazan el look "Windows Forms"
       (rectangular, degradado gris, texto a la izquierda) que el
       cliente pidio cambiar. Portados de POS-500.
       ============================================================ -->
  <!-- Botón de apertura: transparente, el borde lo pinta el ComboBox -->
  <ControlTemplate x:Key="ComboBox.BotonToggle" TargetType="ToggleButton">
    <Border Background="Transparent" />
  </ControlTemplate>

  <Style TargetType="ComboBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Interfaz}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextoPrincipal}" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Fondo" Background="Transparent" CornerRadius="6"
                  Padding="{TemplateBinding Padding}" Margin="4,1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Fondo" Property="Background"
                      Value="{DynamicResource Brush.PrimarioSutil}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Primario}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Fondo" Property="Background"
                      Value="{DynamicResource Brush.PrimarioSutil}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Primario}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Interfaz}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextoPrincipal}" />
    <Setter Property="Background" Value="{DynamicResource Brush.FondoCard}" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Marco"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource Brush.BordeEstandar}"
                    BorderThickness="1" CornerRadius="8" />

            <!-- El ToggleButton cubre toda la caja para que abra al hacer clic -->
            <ToggleButton Template="{StaticResource ComboBox.BotonToggle}"
                          Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                      RelativeSource={RelativeSource TemplatedParent}}" />

            <!-- Texto seleccionado: centrado (el chevron no lo desplaza) -->
            <ContentPresenter x:Name="Contenido"
                              Margin="28,0"
                              IsHitTestVisible="False"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

            <!-- Chevron -->
            <Path x:Name="Chevron" Data="M 0 0 L 4 4 L 8 0"
                  Stroke="{DynamicResource Brush.TextoTerciario}" StrokeThickness="1.6"
                  StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,14,0" IsHitTestVisible="False" />

            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                   AllowsTransparency="True" PopupAnimation="Fade" Focusable="False"
                   VerticalOffset="4">
              <Border Background="{DynamicResource Brush.FondoCard}"
                      BorderBrush="{DynamicResource Brush.BordeSutil}"
                      BorderThickness="1" CornerRadius="8" Padding="0,4"
                      MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Border.Effect>
                  <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="14"
                                    ShadowDepth="2" Direction="270" />
                </Border.Effect>
                <ScrollViewer>
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Marco" Property="BorderBrush"
                      Value="{DynamicResource Brush.Primario}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="Marco" Property="BorderBrush"
                      Value="{DynamicResource Brush.Primario}" />
              <Setter TargetName="Marco" Property="BorderThickness" Value="1.5" />
              <!-- Chevron invertido al abrir -->
              <Setter TargetName="Chevron" Property="RenderTransform">
                <Setter.Value>
                  <RotateTransform Angle="180" CenterX="4" CenterY="2" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Marco" Property="Background"
                      Value="{DynamicResource Brush.FondoApp}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextoDeshabilitado}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================
       DatePicker moderno: mismo lenguaje que ComboBox/Input.Texto
       (el template por defecto también se ve como Windows Forms).
       ============================================================ -->
  <Style TargetType="DatePickerTextBox">
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Interfaz}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextoPrincipal}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePickerTextBox">
          <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Focusable="False" HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Hidden" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DatePicker">
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Interfaz}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextoPrincipal}" />
    <Setter Property="Background" Value="{DynamicResource Brush.FondoCard}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePicker">
          <Border x:Name="Marco"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource Brush.BordeEstandar}"
                  BorderThickness="1" CornerRadius="8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                 Margin="12,0,0,0" VerticalAlignment="Center" />

              <!-- Botón del calendario: icono, no el cuadrito clásico -->
              <Button x:Name="PART_Button" Grid.Column="1" Width="34" Focusable="False"
                      Cursor="Hand" Background="Transparent" BorderThickness="0">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="FondoBoton" Background="Transparent" CornerRadius="6"
                            Margin="0,4,4,4">
                      <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                 Foreground="{DynamicResource Brush.TextoTerciario}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="FondoBoton" Property="Background"
                                Value="{DynamicResource Brush.PrimarioSutil}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>

              <Popup x:Name="PART_Popup" Grid.Column="0" Placement="Bottom"
                     AllowsTransparency="True" StaysOpen="False" />
            </Grid>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Marco" Property="BorderBrush"
                      Value="{DynamicResource Brush.Primario}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Marco" Property="BorderBrush"
                      Value="{DynamicResource Brush.Primario}" />
              <Setter TargetName="Marco" Property="BorderThickness" Value="1.5" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Marco" Property="Background"
                      Value="{DynamicResource Brush.FondoApp}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextoDeshabilitado}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================
       ScrollBars delgados (6px) para TODA la app: discretos pero
       funcionales — pedido de Yuber 2026-07-10 (punto 4)
       ============================================================ -->
  <Style x:Key="Scroll.Pagina" TargetType="RepeatButton">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Scroll.Pulgar" TargetType="Thumb">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Fondo" Background="{DynamicResource Brush.BordeEstandar}"
                  CornerRadius="3" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Background"
                      Value="{DynamicResource Brush.TextoTerciario}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Implícito: aplica a todos los ScrollViewer (formularios, tablas, combos) -->
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource Scroll.Pagina}"
                              Command="ScrollBar.PageUpCommand" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource Scroll.Pulgar}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource Scroll.Pagina}"
                              Command="ScrollBar.PageDownCommand" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource Scroll.Pagina}"
                                  Command="ScrollBar.PageLeftCommand" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource Scroll.Pulgar}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource Scroll.Pagina}"
                                  Command="ScrollBar.PageRightCommand" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================================================
       Navegación del sidebar (RadioButton para exclusión mutua)
       ============================================================ -->
  <Style x:Key="Sidebar.Item" TargetType="RadioButton">
    <Setter Property="Height" Value="40" />
    <Setter Property="Margin" Value="12,2" />
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Interfaz}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextoSecundario}" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- GroupName ÚNICO por ítem (= su Content): sin esto, dos ítems que apuntan
         a la MISMA página (p. ej. "Préstamos" y su gemelo colapsado "Ventas
         financiadas") comparten grupo y el colapsado le roba el check al visible,
         obligando a un segundo click. Con grupos distintos, el estado lo maneja
         SOLO el binding IsChecked (el converter de página). -->
    <Setter Property="GroupName" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Fondo" Background="Transparent" CornerRadius="8" Padding="12,0">
            <!-- Ícono opcional en Tag (glifo Segoe MDL2 Assets, nativo de Windows) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                         FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
              <ContentPresenter VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.FondoApp}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <!-- Acento del MODO activo (lo fija MostrarModo): Prest dorado,
                   Auto verde, DealControl azul. -->
              <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.SidebarSel.Fondo}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.SidebarSel.Texto}" />
              <Setter Property="FontWeight" Value="Medium" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================
       Tablas — DESIGN.md §8: header #F4F4F2 uppercase, filas 44px,
       border-bottom 0.5, hover #FAFAF9, selección indigo 50, sin zebra
       ============================================================ -->
  <Style x:Key="Tabla.Encabezado" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource Brush.FondoEncabezadoTabla}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextoSecundario}" />
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Interfaz}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- Variante alineada a la izquierda: columnas de texto largo
       (Estado, Nombre, Cliente) — pedido de Yuber 2026-07-10 -->
  <Style x:Key="Tabla.Encabezado.Izquierda" TargetType="DataGridColumnHeader"
         BasedOn="{StaticResource Tabla.Encabezado}">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <Style x:Key="Tabla.Celda" TargetType="DataGridCell">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextoPrincipal}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" Padding="12,0">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextoPrincipal}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Tabla.Fila" TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BordeSutil}" />
    <Setter Property="BorderThickness" Value="0,0,0,0.5" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.FondoApp}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.PrimarioSutil}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Tabla" TargetType="DataGrid">
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="CanUserResizeRows" Value="False" />
    <Setter Property="CanUserReorderColumns" Value="False" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RowHeight" Value="44" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Interfaz}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource Tabla.Encabezado}" />
    <Setter Property="CellStyle" Value="{StaticResource Tabla.Celda}" />
    <Setter Property="RowStyle" Value="{StaticResource Tabla.Fila}" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <!-- Scroll horizontal: si las columnas no caben, se desplaza en vez de recortar.
         Pedido del cliente 2026-07-27: la fila mantiene su alto fijo (44) y el
         grid se mueve de lado, así ninguna columna corta la información. Por eso
         las columnas se miden por su CONTENIDO (Auto) y no en fracciones (*):
         con * las columnas se encogen entre ellas y el texto se recorta. -->
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ColumnWidth" Value="Auto" />
    <Setter Property="CanUserResizeColumns" Value="True" />
  </Style>

  <!-- ============================================================
       Pills de estado — DESIGN.md §8: padding 3/10, radius 6, 11px semibold
       ============================================================ -->
  <Style x:Key="Pill" TargetType="Border">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Pill.Texto" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Interfaz}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Pill del semáforo de cobros: colorea según la propiedad Semaforo de la fila -->
  <Style x:Key="Pill.Semaforo" TargetType="Border" BasedOn="{StaticResource Pill}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding Semaforo}" Value="{x:Static m:SemaforoCuota.AlDia}">
        <Setter Property="Background" Value="{DynamicResource Brush.AlDia.Fondo}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Semaforo}" Value="{x:Static m:SemaforoCuota.PorVencer}">
        <Setter Property="Background" Value="{DynamicResource Brush.PorVencer.Fondo}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Semaforo}" Value="{x:Static m:SemaforoCuota.Vencida}">
        <Setter Property="Background" Value="{DynamicResource Brush.Vencido.Fondo}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Semaforo}" Value="{x:Static m:SemaforoCuota.EnMora}">
        <Setter Property="Background" Value="{DynamicResource Brush.EnMora.Fondo}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Semaforo}" Value="{x:Static m:SemaforoCuota.Pagada}">
        <Setter Property="Background" Value="{DynamicResource Brush.Pagado.Fondo}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Semaforo}" Value="{x:Static m:SemaforoCuota.Cancelada}">
        <Setter Property="Background" Value="{DynamicResource Brush.Cancelado.Fondo}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Pill.Semaforo.Texto" TargetType="TextBlock" BasedOn="{StaticResource Pill.Texto}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding Semaforo}" Value="{x:Static m:SemaforoCuota.AlDia}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.AlDia.Texto}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Semaforo}" Value="{x:Static m:SemaforoCuota.PorVencer}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.PorVencer.Texto}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Semaforo}" Value="{x:Static m:SemaforoCuota.Vencida}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Vencido.Texto}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Semaforo}" Value="{x:Static m:SemaforoCuota.EnMora}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.EnMora.Texto}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Semaforo}" Value="{x:Static m:SemaforoCuota.Pagada}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Pagado.Texto}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Semaforo}" Value="{x:Static m:SemaforoCuota.Cancelada}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Cancelado.Texto}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Pill del estado de préstamo: Activo verde, Pagado azul, Cancelado gris -->
  <Style x:Key="Pill.EstadoPrestamo" TargetType="Border" BasedOn="{StaticResource Pill}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding Estado}" Value="{x:Static m:EstadoPrestamo.Activo}">
        <Setter Property="Background" Value="{DynamicResource Brush.AlDia.Fondo}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Estado}" Value="{x:Static m:EstadoPrestamo.Pagado}">
        <Setter Property="Background" Value="{DynamicResource Brush.Pagado.Fondo}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Estado}" Value="{x:Static m:EstadoPrestamo.Cancelado}">
        <Setter Property="Background" Value="{DynamicResource Brush.Cancelado.Fondo}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Pill.EstadoPrestamo.Texto" TargetType="TextBlock" BasedOn="{StaticResource Pill.Texto}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding Estado}" Value="{x:Static m:EstadoPrestamo.Activo}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.AlDia.Texto}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Estado}" Value="{x:Static m:EstadoPrestamo.Pagado}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Pagado.Texto}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Estado}" Value="{x:Static m:EstadoPrestamo.Cancelado}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Cancelado.Texto}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Mini-card de métrica (resumen en detalle / preview de amortización) -->
  <Style x:Key="Card.Metrica" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="Padding" Value="16,12" />
  </Style>

  <!-- ============================================================
       Valor de tarjeta de metrica: Viewbox DownOnly. El monto se
       ENCOGE para caber en vez de recortarse. Sin esto, con el texto
       en Grande o la ventana angosta se ve "RD$ 2,160,000," (queja
       del cliente 2026-07-16). DownOnly = nunca agranda de mas.
       ============================================================ -->
  <Style x:Key="Metrica.Valor" TargetType="Viewbox">
    <Setter Property="StretchDirection" Value="DownOnly" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="MaxHeight" Value="38" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <!-- ============================================================
       Punto de venta (POS-500, 2026-07-30)
       Reusan los mismos brushes del semáforo de cobros: verde/amarillo/
       naranja/rojo ya estaban definidos para las cuotas, y significan lo
       mismo aquí — de más lejos a más urgente.
       ============================================================ -->

  <!-- Semáforo de caducidad de un producto -->
  <Style x:Key="Pill.Caducidad" TargetType="Border" BasedOn="{StaticResource Pill}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding Semaforo}" Value="{x:Static pos:SemaforoCaducidad.Verde}">
        <Setter Property="Background" Value="{DynamicResource Brush.AlDia.Fondo}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Semaforo}" Value="{x:Static pos:SemaforoCaducidad.Amarillo}">
        <Setter Property="Background" Value="{DynamicResource Brush.PorVencer.Fondo}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Semaforo}" Value="{x:Static pos:SemaforoCaducidad.Naranja}">
        <Setter Property="Background" Value="{DynamicResource Brush.Vencido.Fondo}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Semaforo}" Value="{x:Static pos:SemaforoCaducidad.Rojo}">
        <Setter Property="Background" Value="{DynamicResource Brush.EnMora.Fondo}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Pill.Caducidad.Texto" TargetType="TextBlock" BasedOn="{StaticResource Pill.Texto}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding Semaforo}" Value="{x:Static pos:SemaforoCaducidad.Verde}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.AlDia.Texto}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Semaforo}" Value="{x:Static pos:SemaforoCaducidad.Amarillo}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.PorVencer.Texto}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Semaforo}" Value="{x:Static pos:SemaforoCaducidad.Naranja}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Vencido.Texto}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Semaforo}" Value="{x:Static pos:SemaforoCaducidad.Rojo}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.EnMora.Texto}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Estado de una factura: emitida / anulada -->
  <Style x:Key="Pill.EstadoFactura" TargetType="Border" BasedOn="{StaticResource Pill}">
    <Setter Property="Background" Value="{DynamicResource Brush.Pagado.Fondo}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Estado}" Value="{x:Static pos:EstadoFactura.Anulada}">
        <Setter Property="Background" Value="{DynamicResource Brush.EnMora.Fondo}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Pill.EstadoFactura.Texto" TargetType="TextBlock" BasedOn="{StaticResource Pill.Texto}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Pagado.Texto}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Estado}" Value="{x:Static pos:EstadoFactura.Anulada}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.EnMora.Texto}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
