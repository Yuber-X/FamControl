<Window x:Class="FAControl.Views.AyudaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayuda y soporte"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.FondoApp}">

  <Border Margin="24" Style="{DynamicResource Card}">
    <StackPanel>
      <TextBlock Text="¿Algo no funciona como debería?"
                 Style="{DynamicResource Texto.Titulo3}" />
      <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                 Text="Escribí o llamá con confianza. Se atiende cualquier inconveniente con FAControl." />

      <!-- El número, grande y copiable: es el dato que la gente vino a buscar -->
      <Border Margin="0,18,0,0" CornerRadius="10" Padding="18,14"
              Background="{DynamicResource Brush.PrimarioSutil}">
        <StackPanel>
          <TextBlock x:Name="TextoDesarrollador"
                     Style="{DynamicResource Texto.Caption}" />
          <TextBlock x:Name="TextoTelefono" FontSize="26" FontWeight="SemiBold"
                     Margin="0,2,0,0"
                     Foreground="{DynamicResource Brush.Primario}" />
        </StackPanel>
      </Border>

      <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="Abrir WhatsApp" Style="{DynamicResource Boton.Primario}"
                Click="WhatsApp_Click" />
        <Button Grid.Column="2" x:Name="BotonCopiar" Content="Copiar número"
                Style="{DynamicResource Boton.Secundario}" Click="Copiar_Click" />
      </Grid>

      <Border Height="1" Background="{DynamicResource Brush.BordeSutil}" Margin="0,20,0,14" />

      <TextBlock Text="Para resolverlo rápido, contá esto"
                 Style="{DynamicResource Texto.CuerpoEnfatizado}" />
      <ItemsControl x:Name="ListaQueContar" Margin="0,8,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- Con Style: sin él, WPF pinta el texto negro y en modo noche
                 desaparece contra el fondo oscuro -->
            <TextBlock Text="{Binding}" Style="{DynamicResource Texto.Caption}"
                       TextWrapping="Wrap" Margin="0,0,0,5" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock x:Name="TextoVersion" Style="{DynamicResource Texto.Caption}"
                 TextWrapping="Wrap" Margin="0,14,0,0" />

      <Button Content="Cerrar" Style="{DynamicResource Boton.Terciario}" Margin="0,18,0,0"
              HorizontalAlignment="Right" IsCancel="True" Click="Cerrar_Click" />
    </StackPanel>
  </Border>
</Window>
