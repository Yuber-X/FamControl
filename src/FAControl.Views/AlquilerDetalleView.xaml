<UserControl x:Class="FAControl.Views.AlquilerDetalleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FAControl.Views"
             DataContextChanged="AlquilerDetalleView_DataContextChanged">

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
    <StackPanel>

      <!-- ============ ENCABEZADO ============ -->
      <DockPanel Margin="0,0,0,16">
        <Button DockPanel.Dock="Left" Content="← Alquileres"
                Style="{DynamicResource Boton.Terciario}" VerticalAlignment="Center"
                Command="{Binding VolverCommand}" />
        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Codigo}" Style="{DynamicResource Texto.Titulo2}"
                     FontFamily="{DynamicResource Fuente.Mono}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ClienteNombre}" Style="{DynamicResource Texto.Titulo2}"
                     Margin="12,0,0,0" VerticalAlignment="Center" />
          <Border CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center"
                  Background="{DynamicResource Brush.PrimarioSutil}">
            <TextBlock Text="{Binding EstadoTexto}" FontSize="11"
                       Foreground="{DynamicResource Brush.Primario}" />
          </Border>
        </StackPanel>
      </DockPanel>

      <!-- ============ ACCIONES ============ -->
      <!-- Los dos botones que se pidieron. Solo los ve el Admin, o quien él
           habilite: cerrar libera un vehículo y puede implicar devolver plata. -->
      <WrapPanel Margin="0,0,0,14">
        <Button Content="Editar" Style="{DynamicResource Boton.Secundario}"
                Command="{Binding EditarCommand}" Margin="0,0,8,8"
                ToolTip="Corregir errores de digitación de este alquiler"
                Visibility="{Binding PuedeOperar, Converter={StaticResource BoolAVisibilidad}}" />
        <!-- UN solo botón para devolución y cancelación: el diálogo pregunta
             cuál de las dos es, porque para la plata no son lo mismo. -->
        <Button Content="Cerrar alquiler" Style="{DynamicResource Boton.Destructivo}"
                Command="{Binding CerrarCommand}" Margin="0,0,8,8"
                ToolTip="Registrar la devolución del vehículo o cancelar el contrato"
                Visibility="{Binding PuedeOperar, Converter={StaticResource BoolAVisibilidad}}" />
      </WrapPanel>

      <!-- ============ AVISO DE ATRASO (contrato abierto y vencido) ============ -->
      <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,12"
              Background="{DynamicResource Brush.EnMora.Fondo}"
              Visibility="{Binding EstaAtrasado, Converter={StaticResource BoolAVisibilidad}}">
        <StackPanel>
          <TextBlock Text="El vehículo está atrasado" Style="{DynamicResource Texto.CuerpoEnfatizado}"
                     Foreground="{DynamicResource Brush.EnMora.Texto}" />
          <TextBlock Text="{Binding AtrasoTexto}" Style="{DynamicResource Texto.Caption}"
                     Foreground="{DynamicResource Brush.EnMora.Texto}"
                     TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <!-- ============ CARTEL DEL CIERRE ============ -->
      <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,12"
              Background="{DynamicResource Brush.EnMora.Fondo}"
              Visibility="{Binding EstaCerrado, Converter={StaticResource BoolAVisibilidad}}">
        <StackPanel>
          <TextBlock Text="{Binding CierreTitulo}" Style="{DynamicResource Texto.CuerpoEnfatizado}"
                     Foreground="{DynamicResource Brush.EnMora.Texto}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CierreTexto}" Style="{DynamicResource Texto.Caption}"
                     Foreground="{DynamicResource Brush.EnMora.Texto}"
                     TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <!-- ============ MÉTRICAS ============ -->
      <UniformGrid Rows="1" Columns="3" Margin="0,0,0,12">
        <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="TARIFA POR DÍA" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding TarifaDia, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Titulo2}" />
            </Viewbox>
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="DÍAS PACTADOS" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding Dias}" Style="{DynamicResource Texto.Titulo2}" />
            </Viewbox>
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Card.Metrica}">
          <StackPanel>
            <TextBlock Text="MONTO PACTADO" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding MontoTotal, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Titulo2}" />
            </Viewbox>
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- ============ DATOS DEL CONTRATO ============ -->
      <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Datos del alquiler" Style="{DynamicResource Texto.Titulo3}"
                     Margin="0,0,0,12" />
          <UniformGrid Columns="2">
            <StackPanel Margin="0,0,16,10">
              <TextBlock Text="VEHÍCULO" Style="{DynamicResource Texto.MicroLabel}" />
              <TextBlock Text="{Binding VehiculoDescripcion}" Style="{DynamicResource Texto.Cuerpo}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
              <TextBlock Text="MATRÍCULA / PLACA" Style="{DynamicResource Texto.MicroLabel}" />
              <TextBlock Text="{Binding VehiculoMatricula}" Style="{DynamicResource Texto.Cuerpo}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,10">
              <TextBlock Text="PERÍODO PACTADO" Style="{DynamicResource Texto.MicroLabel}" />
              <TextBlock Text="{Binding PeriodoTexto}" Style="{DynamicResource Texto.Cuerpo}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
              <TextBlock Text="CÉDULA DEL CLIENTE" Style="{DynamicResource Texto.MicroLabel}" />
              <TextBlock Text="{Binding ClienteCedula}" Style="{DynamicResource Texto.Cuerpo}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="TELÉFONO" Style="{DynamicResource Texto.MicroLabel}" />
              <TextBlock Text="{Binding ClienteTelefono}" Style="{DynamicResource Texto.Cuerpo}" />
            </StackPanel>
          </UniformGrid>

          <StackPanel Margin="0,8,0,0"
                      Visibility="{Binding TieneNotas, Converter={StaticResource BoolAVisibilidad}}">
            <TextBlock Text="NOTAS" Style="{DynamicResource Texto.MicroLabel}" />
            <TextBlock Text="{Binding NotasTexto}" Style="{DynamicResource Texto.Cuerpo}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============ EXPEDIENTE DEL CLIENTE ============
           El mismo control que DealControl, con el ExpedienteViewModel del
           ALQUILER (pedido de Yuber 2026-07-31: "cambialo por algo parecido a
           expediente del cliente ya que es el mas completo de todos los
           intentos hasta ahora").

           Aca van el contrato firmado, la licencia del conductor y las fotos
           del auto al salir y al volver — las que evitan discusiones por un
           golpe que ya venia. Los datos no se mezclan con los de las ventas:
           cada expediente cuelga de su propio contrato. -->
      <local:ExpedienteClienteView DataContext="{Binding Expediente}" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
