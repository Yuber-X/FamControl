<UserControl x:Class="FAControl.Views.AlquilerDetalleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FAControl.Views"
             DataContextChanged="AlquilerDetalleView_DataContextChanged">

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
    <StackPanel>

      <!-- ============ ENCABEZADO ============ -->
      <DockPanel Margin="0,0,0,16">
        <Button DockPanel.Dock="Left" Content="← Alquileres"
                Style="{DynamicResource Boton.Terciario}" VerticalAlignment="Center"
                Command="{Binding VolverCommand}" />
        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Codigo}" Style="{DynamicResource Texto.Titulo2}"
                     FontFamily="{DynamicResource Fuente.Mono}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ClienteNombre}" Style="{DynamicResource Texto.Titulo2}"
                     Margin="12,0,0,0" VerticalAlignment="Center" />
          <Border CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center"
                  Background="{DynamicResource Brush.PrimarioSutil}">
            <TextBlock Text="{Binding EstadoTexto}" FontSize="11"
                       Foreground="{DynamicResource Brush.Primario}" />
          </Border>
        </StackPanel>
      </DockPanel>

      <!-- ============ ACCIONES ============ -->
      <!-- Los dos botones que se pidieron. Solo los ve el Admin, o quien él
           habilite: cerrar libera un vehículo y puede implicar devolver plata. -->
      <WrapPanel Margin="0,0,0,14">
        <Button Content="Editar" Style="{DynamicResource Boton.Secundario}"
                Command="{Binding EditarCommand}" Margin="0,0,8,8"
                ToolTip="Corregir errores de digitación de este alquiler"
                Visibility="{Binding PuedeOperar, Converter={StaticResource BoolAVisibilidad}}" />
        <!-- UN solo botón para devolución y cancelación: el diálogo pregunta
             cuál de las dos es, porque para la plata no son lo mismo. -->
        <Button Content="Cerrar alquiler" Style="{DynamicResource Boton.Destructivo}"
                Command="{Binding CerrarCommand}" Margin="0,0,8,8"
                ToolTip="Registrar la devolución del vehículo o cancelar el contrato"
                Visibility="{Binding PuedeOperar, Converter={StaticResource BoolAVisibilidad}}" />
      </WrapPanel>

      <!-- ============ AVISO DE ATRASO (contrato abierto y vencido) ============ -->
      <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,12"
              Background="{DynamicResource Brush.EnMora.Fondo}"
              Visibility="{Binding EstaAtrasado, Converter={StaticResource BoolAVisibilidad}}">
        <StackPanel>
          <TextBlock Text="El vehículo está atrasado" Style="{DynamicResource Texto.CuerpoEnfatizado}"
                     Foreground="{DynamicResource Brush.EnMora.Texto}" />
          <TextBlock Text="{Binding AtrasoTexto}" Style="{DynamicResource Texto.Caption}"
                     Foreground="{DynamicResource Brush.EnMora.Texto}"
                     TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <!-- ============ CARTEL DEL CIERRE ============ -->
      <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,12"
              Background="{DynamicResource Brush.EnMora.Fondo}"
              Visibility="{Binding EstaCerrado, Converter={StaticResource BoolAVisibilidad}}">
        <StackPanel>
          <TextBlock Text="{Binding CierreTitulo}" Style="{DynamicResource Texto.CuerpoEnfatizado}"
                     Foreground="{DynamicResource Brush.EnMora.Texto}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CierreTexto}" Style="{DynamicResource Texto.Caption}"
                     Foreground="{DynamicResource Brush.EnMora.Texto}"
                     TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <!-- ============ MÉTRICAS ============ -->
      <UniformGrid Rows="1" Columns="3" Margin="0,0,0,12">
        <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="TARIFA POR DÍA" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding TarifaDia, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Titulo2}" />
            </Viewbox>
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="DÍAS PACTADOS" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding Dias}" Style="{DynamicResource Texto.Titulo2}" />
            </Viewbox>
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Card.Metrica}">
          <StackPanel>
            <TextBlock Text="MONTO PACTADO" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding MontoTotal, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Titulo2}" />
            </Viewbox>
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- ============ DATOS DEL CONTRATO ============ -->
      <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Datos del alquiler" Style="{DynamicResource Texto.Titulo3}"
                     Margin="0,0,0,12" />
          <UniformGrid Columns="2">
            <StackPanel Margin="0,0,16,10">
              <TextBlock Text="VEHÍCULO" Style="{DynamicResource Texto.MicroLabel}" />
              <TextBlock Text="{Binding VehiculoDescripcion}" Style="{DynamicResource Texto.Cuerpo}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
              <TextBlock Text="MATRÍCULA / PLACA" Style="{DynamicResource Texto.MicroLabel}" />
              <TextBlock Text="{Binding VehiculoMatricula}" Style="{DynamicResource Texto.Cuerpo}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,10">
              <TextBlock Text="PERÍODO PACTADO" Style="{DynamicResource Texto.MicroLabel}" />
              <TextBlock Text="{Binding PeriodoTexto}" Style="{DynamicResource Texto.Cuerpo}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
              <TextBlock Text="CÉDULA DEL CLIENTE" Style="{DynamicResource Texto.MicroLabel}" />
              <TextBlock Text="{Binding ClienteCedula}" Style="{DynamicResource Texto.Cuerpo}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="TELÉFONO" Style="{DynamicResource Texto.MicroLabel}" />
              <TextBlock Text="{Binding ClienteTelefono}" Style="{DynamicResource Texto.Cuerpo}" />
            </StackPanel>
          </UniformGrid>

          <StackPanel Margin="0,8,0,0"
                      Visibility="{Binding TieneNotas, Converter={StaticResource BoolAVisibilidad}}">
            <TextBlock Text="NOTAS" Style="{DynamicResource Texto.MicroLabel}" />
            <TextBlock Text="{Binding NotasTexto}" Style="{DynamicResource Texto.Cuerpo}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============ COBROS DEL ALQUILER (034) ============
           Su propio grid y su propia forma de cobrar, como se pidio. El
           alquiler se suele pagar en dos veces: un adelanto al retirar el
           vehiculo y el resto al devolverlo. -->
      <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Cobros" Style="{DynamicResource Texto.Titulo3}" Margin="0,0,0,12" />

          <UniformGrid Rows="1" Columns="3" Margin="0,0,0,12">
            <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="A COBRAR" Style="{DynamicResource Texto.MicroLabel}" />
                <Viewbox Style="{DynamicResource Metrica.Valor}">
                  <TextBlock Text="{Binding MontoACobrar, Converter={StaticResource Money}}"
                             Style="{DynamicResource Texto.Titulo2}" />
                </Viewbox>
              </StackPanel>
            </Border>
            <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="COBRADO" Style="{DynamicResource Texto.MicroLabel}" />
                <Viewbox Style="{DynamicResource Metrica.Valor}">
                  <TextBlock Text="{Binding Cobrado, Converter={StaticResource Money}}"
                             Style="{DynamicResource Texto.Titulo2}" />
                </Viewbox>
              </StackPanel>
            </Border>
            <Border Style="{DynamicResource Card.Metrica}">
              <StackPanel>
                <TextBlock Text="FALTA" Style="{DynamicResource Texto.MicroLabel}" />
                <Viewbox Style="{DynamicResource Metrica.Valor}">
                  <TextBlock Text="{Binding Pendiente, Converter={StaticResource Money}}"
                             Style="{DynamicResource Texto.Titulo2}" />
                </Viewbox>
              </StackPanel>
            </Border>
          </UniformGrid>

          <!-- Pago de mas: NO se mueve plata sola, se avisa y el dueño decide -->
          <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                  Background="{DynamicResource Brush.PrimarioSutil}"
                  Visibility="{Binding HaySaldoAFavor, Converter={StaticResource BoolAVisibilidad}}">
            <TextBlock Text="{Binding SaldoAFavorTexto}" TextWrapping="Wrap"
                       Style="{DynamicResource Texto.Caption}" />
          </Border>

          <!-- Calendario mensual: un alquiler se cobra mes a mes hasta el dia
               pactado, no de una sola vez (pedido 2026-08-01). No se guarda en
               la base: se calcula del periodo y la tarifa. -->
          <TextBlock Text="Cuotas del período" Style="{DynamicResource Texto.CuerpoEnfatizado}"
                     Margin="0,4,0,6"
                     Visibility="{Binding HayCalendario, Converter={StaticResource BoolAVisibilidad}}" />
          <DataGrid Style="{DynamicResource Tabla}" ItemsSource="{Binding Calendario}"
                    Margin="0,0,0,14" MaxHeight="200"
                    Visibility="{Binding HayCalendario, Converter={StaticResource BoolAVisibilidad}}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Numero}" Width="Auto" MinWidth="45" />
              <DataGridTextColumn Header="Período" Binding="{Binding PeriodoTexto}"
                                  Width="Auto" MinWidth="200"
                                  HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
              <DataGridTextColumn Header="Días" Binding="{Binding Dias}" Width="Auto" MinWidth="60" />
              <DataGridTextColumn Header="Monto"
                                  Binding="{Binding Monto, Converter={StaticResource Money}}"
                                  Width="Auto" MinWidth="120">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Cubierto"
                                  Binding="{Binding Pagado, Converter={StaticResource Money}}"
                                  Width="Auto" MinWidth="120">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="*" MinWidth="110"
                                  HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding EstaAtrasada}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.EnMora.Texto}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding EstaPagada}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.DeltaPositivo}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>

          <!-- Registrar un cobro -->
          <Grid Visibility="{Binding PuedeCobrar, Converter={StaticResource BoolAVisibilidad}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Monto a cobrar"
                       Style="{DynamicResource Input.Label}" />
            <TextBox Grid.Row="1" Grid.Column="0" Width="150" Height="36"
                     Style="{DynamicResource Input.Texto}"
                     Text="{Binding MontoCobroTexto, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Forma de pago"
                       Style="{DynamicResource Input.Label}" />
            <ComboBox Grid.Row="1" Grid.Column="2" Width="160" Height="36"
                      ItemsSource="{Binding MetodosPago}"
                      SelectedItem="{Binding MetodoCobro}" />

            <TextBlock Grid.Row="0" Grid.Column="4" Text="Nota (opcional)"
                       Style="{DynamicResource Input.Label}" />
            <TextBox Grid.Row="1" Grid.Column="4" Height="36"
                     Style="{DynamicResource Input.Texto}"
                     Text="{Binding NotaCobro, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Row="1" Grid.Column="6" Content="Registrar cobro"
                    Style="{DynamicResource Boton.Primario}" Height="36"
                    Command="{Binding CobrarCommand}" />
          </Grid>

          <!-- Cuando ya se cobro todo, el formulario se va pero se DICE por que.
               Antes desaparecia sin explicacion y parecia que la pantalla se
               habia roto. Editar y Cerrar siguen estando: no dependen de esto. -->
          <Border CornerRadius="8" Padding="14,10" Margin="0,4,0,0"
                  Background="{DynamicResource Brush.PrimarioSutil}"
                  Visibility="{Binding MostrarSaldado, Converter={StaticResource BoolAVisibilidad}}">
            <TextBlock Style="{DynamicResource Texto.CuerpoEnfatizado}" TextWrapping="Wrap"
                       Text="Este alquiler ya está cobrado por completo. Si el cliente devuelve tarde, al cerrarlo se recalcula lo que falta y vas a poder cobrar la diferencia." />
          </Border>

          <TextBlock Margin="0,12,0,0" Style="{DynamicResource Texto.Caption}"
                     Text="Todavía no se registró ningún cobro de este alquiler."
                     Visibility="{Binding SinCobros, Converter={StaticResource BoolAVisibilidad}}" />

          <DataGrid Style="{DynamicResource Tabla}" ItemsSource="{Binding Cobros}"
                    Margin="0,12,0,0" MaxHeight="220"
                    Visibility="{Binding SinCobros, Converter={StaticResource InversorBoolVisibilidad}}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Recibo" Binding="{Binding NumeroRecibo}" Width="Auto" MinWidth="110">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{DynamicResource Fuente.Mono}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="Auto" MinWidth="110" />
              <DataGridTextColumn Header="Monto"
                                  Binding="{Binding Monto, Converter={StaticResource Money}}"
                                  Width="Auto" MinWidth="130">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Forma" Binding="{Binding MetodoTexto}" Width="Auto" MinWidth="110"
                                  HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
              <DataGridTextColumn Header="Cobró" Binding="{Binding CobradoPorTexto}" Width="Auto" MinWidth="130"
                                  HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
              <DataGridTextColumn Header="Nota" Binding="{Binding NotasTexto}" Width="*" MinWidth="140"
                                  HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <!-- ============ EXPEDIENTE DEL CLIENTE ============
           El mismo control que DealControl, con el ExpedienteViewModel del
           ALQUILER (pedido de Yuber 2026-07-31: "cambialo por algo parecido a
           expediente del cliente ya que es el mas completo de todos los
           intentos hasta ahora").

           Aca van el contrato firmado, la licencia del conductor y las fotos
           del auto al salir y al volver — las que evitan discusiones por un
           golpe que ya venia. Los datos no se mezclan con los de las ventas:
           cada expediente cuelga de su propio contrato. -->
      <local:ExpedienteClienteView DataContext="{Binding Expediente}" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
