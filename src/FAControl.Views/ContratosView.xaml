<UserControl x:Class="FAControl.Views.ContratosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContextChanged="ContratosView_DataContextChanged">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="420" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- ============ LISTA DE CONTRATOS ============ -->
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBox Grid.Row="0" Width="320" HorizontalAlignment="Left" Margin="0,0,0,12"
               Style="{DynamicResource Input.Texto}"
               Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Buscar por cliente o código de préstamo" />

      <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="0">
        <DataGrid Style="{DynamicResource Tabla}"
                  ItemsSource="{Binding Contratos}"
                  SelectedItem="{Binding Seleccionado}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Préstamo" Binding="{Binding Codigo}" Width="100" MinWidth="100">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontFamily" Value="{DynamicResource Fuente.Mono}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="*" MinWidth="160"
                                HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
            <DataGridTextColumn Header="Monto"
                                Binding="{Binding MontoCapital, Converter={StaticResource Money}}"
                                Width="140" MinWidth="140">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="110" MinWidth="110" />
            <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="100" MinWidth="100" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </Grid>

    <!-- ============ VISTA PREVIA DEL CONTRATO ============ -->
    <Border Grid.Column="1" Width="470" Margin="16,0,0,0" Style="{DynamicResource Card}" Padding="0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="16,14,16,10">
          <Button DockPanel.Dock="Right" Content="Ver / imprimir"
                  Style="{DynamicResource Boton.Primario}"
                  Command="{Binding VerCompletoCommand}"
                  IsEnabled="{Binding TieneVistaPrevia}" />
          <TextBlock Text="Contrato (pagaré)" Style="{DynamicResource Texto.Titulo3}"
                     VerticalAlignment="Center" />
        </DockPanel>

        <!-- Aviso cuando no hay contrato seleccionado (visible si NO hay vista previa) -->
        <TextBlock DockPanel.Dock="Top" Margin="16,0" TextWrapping="Wrap"
                   Text="Seleccioná un contrato de la lista para ver su pagaré.">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Caption}">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding TieneVistaPrevia}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <!-- ===== Expediente del cliente (026) =====
             Misma lógica que el expediente de DealControl: los papeles firmados
             viven acá, y el pagaré y la intimación se archivan solos al
             imprimirlos. Va abajo del panel para que la vista previa mande. -->
        <Border DockPanel.Dock="Bottom" DataContext="{Binding Expediente}"
                BorderBrush="{DynamicResource Brush.BordeSutil}" BorderThickness="0,1,0,0"
                Padding="16,12" MaxHeight="260">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="Descargar todo"
                      Style="{DynamicResource Boton.Terciario}"
                      Click="ExportarExpediente_Click" />
              <Button DockPanel.Dock="Right" Content="+ Subir" Margin="0,0,6,0"
                      Style="{DynamicResource Boton.Secundario}"
                      Click="SubirDocumentos_Click" />
              <TextBlock Text="Documentos firmados" Style="{DynamicResource Texto.CuerpoEnfatizado}"
                         VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock DockPanel.Dock="Top" Style="{DynamicResource Texto.Caption}"
                       TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding SinDocumentos, Converter={StaticResource BoolAVisibilidad}}"
                       Text="Todavía no hay papeles. El pagaré y la intimación se guardan solos al imprimirlos; el contrato firmado subilo con &quot;+ Subir&quot;." />

            <DataGrid Style="{DynamicResource Tabla}" ItemsSource="{Binding Documentos}"
                      MouseDoubleClick="Documento_MouseDoubleClick"
                      Visibility="{Binding SinDocumentos, Converter={StaticResource InversorBoolVisibilidad}}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Documento" Binding="{Binding Nombre}" Width="Auto"
                                    HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
                <DataGridTextColumn Header="Tipo" Binding="{Binding TipoTexto}" Width="Auto"
                                    HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="Auto" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <!-- Vista previa del pagaré (mismo FlowDocument que se imprime) -->
        <Border Background="{DynamicResource Brush.FondoApp}" Margin="12"
                BorderBrush="{DynamicResource Brush.BordeSutil}" BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding TieneVistaPrevia, Converter={StaticResource BoolAVisibilidad}}">
          <!-- Zoom fijo para que la hoja carta (816px) entre completa como
               miniatura; para leerlo grande está "Ver / imprimir". -->
          <FlowDocumentScrollViewer x:Name="Visor" Background="Transparent"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled"
                                    IsToolBarVisible="False"
                                    Zoom="52" MinZoom="52" MaxZoom="52" />
        </Border>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
