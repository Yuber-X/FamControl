<UserControl x:Class="FAControl.Views.ContratosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===================== ALMACÉN DE CONTRATOS =====================
       La vista previa lateral del pagaré se quitó el 2026-08-01: ocupaba media
       pantalla para mostrar en miniatura algo que igual había que abrir grande
       para leer, y le robaba ancho a la lista, que es lo que de verdad se usa.

       Cada fila lleva sus dos acciones:
         · Archivos → entra a la pantalla del expediente de ese contrato
         · Pagaré   → abre el documento para verlo o imprimirlo

       El pagaré sigue accesible a propósito: sacar el panel no debía costar la
       posibilidad de imprimirlo. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBox Grid.Row="0" Width="320" HorizontalAlignment="Left" Margin="0,0,0,12"
             Style="{DynamicResource Input.Texto}"
             Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
             ToolTip="Buscar por cliente o código de préstamo" />

    <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="0">
      <DataGrid Style="{DynamicResource Tabla}"
                ItemsSource="{Binding Contratos}"
                SelectedItem="{Binding Seleccionado}"
                MouseDoubleClick="Tabla_MouseDoubleClick">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Préstamo" Binding="{Binding Codigo}" Width="Auto" MinWidth="110">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource Fuente.Mono}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="*" MinWidth="180"
                              HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
          <DataGridTextColumn Header="Monto"
                              Binding="{Binding MontoCapital, Converter={StaticResource Money}}"
                              Width="Auto" MinWidth="140">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="Auto" MinWidth="110" />
          <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="Auto" MinWidth="100"
                              HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />

          <!-- Acciones de la fila -->
          <DataGridTemplateColumn Width="Auto" MinWidth="190">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Archivos" Style="{DynamicResource Boton.Secundario}" FontSize="11"
                          ToolTip="Contratos firmados, cédula y demás papeles de este cliente"
                          Command="{Binding DataContext.VerArchivosCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}" />
                  <Button Content="Pagaré" Style="{DynamicResource Boton.Terciario}" FontSize="11"
                          Margin="6,0,0,0"
                          ToolTip="Ver o imprimir el pagaré de este préstamo"
                          Command="{Binding DataContext.VerPagareCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <TextBlock Grid.Row="2" Text="{Binding ContadorTexto}"
               Style="{DynamicResource Texto.Caption}" Margin="4,10,0,0" />
  </Grid>
</UserControl>
