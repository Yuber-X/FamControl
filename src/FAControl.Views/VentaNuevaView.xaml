<UserControl x:Class="FAControl.Views.VentaNuevaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Border Style="{DynamicResource Card}" MaxWidth="640" VerticalAlignment="Top"
            HorizontalAlignment="Center" Padding="32" Margin="0,8">
      <StackPanel>
        <TextBlock Text="Registrar venta al contado" Style="{DynamicResource Texto.Titulo2}"
                   Margin="0,0,0,20" />

        <TextBlock Text="Vehículo (disponible)" Style="{DynamicResource Input.Label}" />
        <ComboBox Height="40" FontSize="13"
                  ItemsSource="{Binding Vehiculos}" SelectedItem="{Binding VehiculoSeleccionado}">
          <ComboBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Descripcion}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Cliente" Style="{DynamicResource Input.Label}" Margin="0,14,0,6" />
        <ComboBox Height="40" FontSize="13"
                  ItemsSource="{Binding Clientes}" SelectedItem="{Binding ClienteSeleccionado}">
          <ComboBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding NombreCompleto}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Precio de venta (RD$)" Style="{DynamicResource Input.Label}" />
            <TextBox Style="{DynamicResource Input.Texto}"
                     Text="{Binding PrecioTexto, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Método de pago" Style="{DynamicResource Input.Label}" />
            <ComboBox Height="40" FontSize="13"
                      ItemsSource="{Binding MetodosPago}" SelectedItem="{Binding MetodoSeleccionado}" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Notas" Style="{DynamicResource Input.Label}" Margin="0,14,0,6" />
        <TextBox Style="{DynamicResource Input.Texto}" Height="72"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalContentAlignment="Top" Padding="10,8"
                 Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="{Binding MensajeError}"
                   Foreground="{DynamicResource Brush.Destructivo}"
                   Style="{DynamicResource Texto.Caption}"
                   TextWrapping="Wrap" Margin="0,12,0,0" />

        <Grid Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="Cancelar" Style="{DynamicResource Boton.Secundario}"
                  Command="{Binding CancelarCommand}" />
          <Button Grid.Column="2" Content="Registrar venta" Style="{DynamicResource Boton.Primario}"
                  Command="{Binding GuardarCommand}"
                  IsEnabled="{Binding Ocupado, Converter={StaticResource InversorBool}}" />
        </Grid>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
