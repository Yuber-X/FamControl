<UserControl x:Class="FAControl.Views.GastosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="24" />
      <ColumnDefinition Width="360" />
    </Grid.ColumnDefinitions>

    <!-- Izquierda: selección de vehículo + lista de gastos -->
    <DockPanel Grid.Column="0">
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
        <TextBlock Text="Vehículo" Style="{DynamicResource Input.Label}" />
        <ComboBox Height="40" FontSize="13"
                  ItemsSource="{Binding Vehiculos}" SelectedItem="{Binding VehiculoSeleccionado}">
          <ComboBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Descripcion}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="16,12"
              Background="{DynamicResource Brush.PrimarioSutil}" CornerRadius="10">
        <DockPanel>
          <TextBlock Text="Total gastos de importación" Style="{DynamicResource Texto.CuerpoEnfatizado}"
                     VerticalAlignment="Center" />
          <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                     Text="{Binding TotalGastos, Converter={StaticResource Money}}"
                     Style="{DynamicResource Texto.Titulo3}" />
        </DockPanel>
      </Border>

      <Border Style="{DynamicResource Card}" Padding="0">
        <DataGrid Style="{DynamicResource Tabla}" ItemsSource="{Binding Filas}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="Auto" MinWidth="140"
                                HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
            <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="120" />
            <DataGridTextColumn Header="Monto"
                                Binding="{Binding Monto, Converter={StaticResource Money}}"
                                Width="150" MinWidth="130">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTemplateColumn Width="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="Quitar" Style="{DynamicResource Boton.Terciario}"
                          Visibility="{Binding DataContext.PuedeEditar,
                                      RelativeSource={RelativeSource AncestorType=DataGrid},
                                      Converter={StaticResource BoolAVisibilidad}}"
                          Command="{Binding DataContext.EliminarCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </DockPanel>

    <!-- Derecha: agregar gasto -->
    <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="24" VerticalAlignment="Top"
            Visibility="{Binding PuedeEditar, Converter={StaticResource BoolAVisibilidad}}">
      <StackPanel>
        <TextBlock Text="Agregar gasto" Style="{DynamicResource Texto.Titulo3}" Margin="0,0,0,14" />

        <TextBlock Text="Concepto" Style="{DynamicResource Input.Label}" />
        <TextBox Style="{DynamicResource Input.Texto}"
                 Text="{Binding Concepto, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Aduana, flete, grúa, preparación..." />

        <TextBlock Text="Monto (RD$)" Style="{DynamicResource Input.Label}" Margin="0,14,0,6" />
        <TextBox Style="{DynamicResource Input.Texto}"
                 Text="{Binding MontoTexto, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Fecha" Style="{DynamicResource Input.Label}" Margin="0,14,0,6" />
        <DatePicker SelectedDate="{Binding FechaGasto}" />

        <TextBlock Text="{Binding MensajeError}"
                   Foreground="{DynamicResource Brush.Destructivo}"
                   Style="{DynamicResource Texto.Caption}"
                   TextWrapping="Wrap" Margin="0,12,0,0" />

        <Button Content="+ Agregar gasto" Style="{DynamicResource Boton.Primario}"
                Margin="0,18,0,0" Command="{Binding AgregarCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
