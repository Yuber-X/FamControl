<Window x:Class="FAControl.Views.FacturaVentaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Factura de venta"
        Width="920" Height="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.FondoApp}">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Vista previa: el visual mostrado es EXACTAMENTE el que se imprime -->
    <Border Grid.Row="0" Background="{DynamicResource Brush.FondoApp}" CornerRadius="8"
            BorderBrush="{DynamicResource Brush.BordeEstandar}" BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                    Padding="16">
        <Border Background="White" HorizontalAlignment="Center"
                BorderBrush="{DynamicResource Brush.BordeSutil}" BorderThickness="1">
          <ContentControl x:Name="ContenedorFactura" />
        </Border>
      </ScrollViewer>
    </Border>

    <!-- Acciones -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Imprimir" Style="{DynamicResource Boton.Primario}" MinWidth="120"
              Click="BotonImprimir_Click" />
      <Button Content="Guardar PDF" Style="{DynamicResource Boton.Secundario}" MinWidth="120"
              Margin="8,0,0,0" Click="BotonPdf_Click" />
      <Button Content="Cerrar" Style="{DynamicResource Boton.Secundario}" MinWidth="120"
              Margin="8,0,0,0" Click="BotonCerrar_Click" />
    </StackPanel>
  </Grid>
</Window>
