<Window x:Class="FAControl.Views.AutorizacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autorización requerida"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.FondoApp}">

  <Border Margin="24" Style="{DynamicResource Card}">
    <StackPanel>
      <TextBlock Text="Autorización de administrador"
                 Style="{DynamicResource Texto.Titulo3}" TextWrapping="Wrap" />
      <TextBlock x:Name="TextoMotivo" Style="{DynamicResource Texto.Caption}"
                 TextWrapping="Wrap" Margin="0,6,0,0" />

      <TextBlock Text="Usuario administrador" Style="{DynamicResource Input.Label}" Margin="0,16,0,0" />
      <TextBox x:Name="CajaUsuario" Style="{DynamicResource Input.Texto}"
               KeyDown="Campo_KeyDown" />

      <TextBlock Text="Contraseña" Style="{DynamicResource Input.Label}" Margin="0,10,0,0" />
      <PasswordBox x:Name="CajaPassword" Style="{DynamicResource Input.Password}"
                   KeyDown="Campo_KeyDown" />

      <TextBlock x:Name="TextoError" TextWrapping="Wrap" Margin="0,12,0,0"
                 Style="{DynamicResource Texto.Caption}"
                 Foreground="{DynamicResource Brush.Destructivo}" />

      <Grid Margin="0,20,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="BotonAutorizar" Grid.Column="0" Content="Autorizar"
                Style="{DynamicResource Boton.Primario}" Click="BotonAutorizar_Click" />
        <Button Grid.Column="2" Content="Cancelar" IsCancel="True"
                Style="{DynamicResource Boton.Secundario}" Click="BotonCancelar_Click" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
