<Window x:Class="FAControl.Views.ExpedienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contratos y documentos"
        Width="980" Height="660" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.FondoApp}">

  <Border Margin="16" Style="{DynamicResource Card}">
    <DockPanel>

      <!-- ============ ENCABEZADO ============ -->
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock x:Name="TextoTitulo" Style="{DynamicResource Texto.Titulo3}" />
          <TextBlock x:Name="TextoSubtitulo" Style="{DynamicResource Texto.Caption}"
                     Margin="0,2,0,0" />
        </StackPanel>

        <!-- Cambio de vista: los dos modos que se pidieron -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="&#xE8FD;  Lista" FontFamily="Segoe MDL2 Assets" FontSize="12"
                  Command="{Binding VerEnListaCommand}" Margin="0,0,6,0"
                  ToolTip="Ver los detalles de cada archivo junto a su nombre">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Boton.Terciario}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding VistaLista}" Value="True">
                    <Setter Property="Style" Value="{DynamicResource Boton.Secundario}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="&#xE80A;  Iconos" FontFamily="Segoe MDL2 Assets" FontSize="12"
                  Command="{Binding VerEnCuadriculaCommand}"
                  ToolTip="Ver los archivos en grande, con el ícono de su tipo">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Boton.Terciario}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding VistaCuadricula}" Value="True">
                    <Setter Property="Style" Value="{DynamicResource Boton.Secundario}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
      </DockPanel>

      <!-- ============ ACCIONES ============ -->
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
        <Button DockPanel.Dock="Left" Content="+ Subir archivos"
                Style="{DynamicResource Boton.Primario}"
                Click="SubirDocumentos_Click" />
        <Button DockPanel.Dock="Left" Content="Descargar todo (ZIP)" Margin="8,0,0,0"
                Style="{DynamicResource Boton.Secundario}"
                Click="ExportarExpediente_Click"
                Visibility="{Binding SinDocumentos, Converter={StaticResource InversorBoolVisibilidad}}" />
        <TextBlock x:Name="TextoConteo" Style="{DynamicResource Texto.Caption}"
                   VerticalAlignment="Center" HorizontalAlignment="Right" />
      </DockPanel>

      <!-- Aviso de que no hay nada todavía, con los formatos aceptados: es la
           primera pregunta que aparece frente a una pantalla vacía. -->
      <Border DockPanel.Dock="Top" CornerRadius="8" Padding="16,14" Margin="0,0,0,4"
              Background="{DynamicResource Brush.PrimarioSutil}"
              Visibility="{Binding SinDocumentos, Converter={StaticResource BoolAVisibilidad}}">
        <StackPanel>
          <TextBlock Text="Todavía no hay ningún archivo acá."
                     Style="{DynamicResource Texto.CuerpoEnfatizado}" />
          <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                     Text="Subí los papeles que te entregó el cliente: PDF, Word, Excel, imágenes o texto. El pagaré y la intimación se archivan solos al imprimirlos." />
        </StackPanel>
      </Border>

      <!-- ============ VISTA 1: LISTA CON DETALLES ============ -->
      <DataGrid Style="{DynamicResource Tabla}" ItemsSource="{Binding Documentos}"
                MouseDoubleClick="Documento_MouseDoubleClick"
                Visibility="{Binding VistaLista, Converter={StaticResource BoolAVisibilidad}}">
        <DataGrid.Columns>
          <!-- El ícono también acá: identificar el tipo de un vistazo es lo que
               hace útil la lista cuando hay muchos papeles del mismo cliente. -->
          <DataGridTemplateColumn Header="" Width="44">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Icono}" FontFamily="Segoe MDL2 Assets" FontSize="17"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Primario}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Documento" Binding="{Binding Nombre}" Width="*" MinWidth="220"
                              HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
          <DataGridTextColumn Header="Para qué" Binding="{Binding TipoTexto}" Width="130"
                              HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
          <DataGridTextColumn Header="Formato" Binding="{Binding Familia}" Width="100"
                              HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
          <DataGridTextColumn Header="Tamaño" Binding="{Binding TamanoTexto}" Width="95" />
          <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="105" />
          <DataGridTextColumn Header="Subió" Binding="{Binding SubidoPorTexto}" Width="150"
                              HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
          <DataGridTemplateColumn Width="100">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="Abrir…" Style="{DynamicResource Boton.Terciario}" FontSize="11"
                        Tag="{Binding}" Click="AccionesDocumento_Click" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <!-- ============ VISTA 2: ICONOS GRANDES ============ -->
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding VistaCuadricula, Converter={StaticResource BoolAVisibilidad}}">
        <ItemsControl ItemsSource="{Binding Documentos}" Margin="0,4,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- Más grandes que en el panel lateral: acá hay pantalla de
                   sobra y el pedido fue justamente poder distinguirlos cuando
                   un cliente tiene varios papeles. -->
              <Button Width="168" Height="176" Margin="0,0,12,12" Cursor="Hand"
                      Tag="{Binding}" Click="AccionesDocumento_Click"
                      ToolTip="{Binding Nombre}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Marco" CornerRadius="10" Padding="12"
                            Background="{DynamicResource Brush.FondoApp}"
                            BorderBrush="{DynamicResource Brush.BordeSutil}" BorderThickness="1">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Icono}" FontFamily="Segoe MDL2 Assets"
                                   FontSize="46" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Primario}" />
                        <TextBlock Text="{Binding Nombre}" FontSize="12" Margin="0,12,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="34"
                                   Foreground="{DynamicResource Brush.TextoPrincipal}" />
                        <!-- Tipo de archivo, que fue parte del pedido -->
                        <TextBlock Text="{Binding Familia}" FontSize="11" Margin="0,6,0,0"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextoSecundario}" />
                        <TextBlock FontSize="10" Margin="0,2,0,0" TextAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextoTerciario}">
                          <Run Text="{Binding TamanoTexto, Mode=OneWay}" />
                          <Run Text="·" />
                          <Run Text="{Binding FechaTexto, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Marco" Property="BorderBrush"
                                Value="{DynamicResource Brush.Primario}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
