<Window x:Class="FAControl.Views.PagareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pagaré"
        Width="900" Height="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.FondoApp}">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Vista previa: el mismo FlowDocument que se imprime, paginado.
         FlowDocumentPageViewer muestra las páginas tal como saldrán. -->
    <Border Grid.Row="0" Background="{DynamicResource Brush.FondoApp}" CornerRadius="8"
            BorderBrush="{DynamicResource Brush.BordeEstandar}" BorderThickness="1">
      <FlowDocumentPageViewer x:Name="Visor" Background="Transparent" />
    </Border>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Imprimir pagaré" Style="{DynamicResource Boton.Primario}" MinWidth="140"
              Click="BotonImprimir_Click" />
      <Button Content="Cerrar" Style="{DynamicResource Boton.Secundario}" MinWidth="120"
              Margin="8,0,0,0" Click="BotonCerrar_Click" />
    </StackPanel>
  </Grid>
</Window>
