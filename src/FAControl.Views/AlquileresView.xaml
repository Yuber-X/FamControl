<UserControl x:Class="FAControl.Views.AlquileresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <Button DockPanel.Dock="Right" Content="+ Nuevo alquiler"
              Style="{DynamicResource Boton.Primario}"
              Visibility="{Binding PuedeEditar, Converter={StaticResource BoolAVisibilidad}}"
              Command="{Binding NuevoCommand}" />
      <TextBlock Text="Rent a car — contratos de alquiler" VerticalAlignment="Center"
                 Style="{DynamicResource Texto.Cuerpo}" />
    </DockPanel>

    <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="0">
      <DataGrid Style="{DynamicResource Tabla}" ItemsSource="{Binding Filas}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="90">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource Fuente.Mono}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Vehículo" Binding="{Binding Vehiculo}" Width="Auto" MinWidth="150"
                              HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
          <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="Auto" MinWidth="140"
                              HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
          <DataGridTextColumn Header="Período" Binding="{Binding PeriodoTexto}" Width="190" MinWidth="180" />
          <DataGridTextColumn Header="Días" Binding="{Binding Dias}" Width="70" />
          <DataGridTextColumn Header="Total"
                              Binding="{Binding MontoTotal, Converter={StaticResource Money}}"
                              Width="150" MinWidth="130">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="110" MinWidth="100" />
          <DataGridTemplateColumn Width="200">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding EstaActivo, Converter={StaticResource BoolAVisibilidad}}">
                  <Button Content="Devolver" Style="{DynamicResource Boton.Terciario}"
                          Command="{Binding DataContext.DevolverCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}" />
                  <Button Content="Cancelar" Style="{DynamicResource Boton.Terciario}"
                          Margin="4,0,0,0"
                          Command="{Binding DataContext.CancelarCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <TextBlock Grid.Row="2" Text="{Binding ContadorTexto}"
               Style="{DynamicResource Texto.Caption}" Margin="4,10,0,0" />
  </Grid>
</UserControl>
