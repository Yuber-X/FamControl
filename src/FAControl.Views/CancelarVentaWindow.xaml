<Window x:Class="FAControl.Views.CancelarVentaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cancelar la venta"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.FondoApp}">

  <Border Margin="24" Style="{DynamicResource Card}">
    <StackPanel>
      <TextBlock x:Name="TextoTitulo" Style="{DynamicResource Texto.Titulo3}"
                 Foreground="{DynamicResource Brush.Destructivo}" TextWrapping="Wrap" />
      <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                 Text="El cliente devuelve el vehículo. La venta NO se borra: queda registrada como cancelada, el vehículo vuelve al inventario y los plazos que faltaban se cancelan." />

      <TextBlock Text="Motivo (queda en el historial)" Style="{DynamicResource Input.Label}"
                 Margin="0,16,0,0" />
      <TextBox x:Name="CajaMotivo" Style="{DynamicResource Input.Texto}" Height="56"
               TextWrapping="Wrap" AcceptsReturn="True"
               VerticalContentAlignment="Top" Padding="10,8" />

      <Border Height="1" Background="{DynamicResource Brush.BordeSutil}" Margin="0,18,0,14" />

      <TextBlock Text="¿Qué porcentaje de lo cobrado se queda el negocio?"
                 Style="{DynamicResource Input.Label}" />
      <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,2,0,6"
                 Text="Por depreciación, uso y gastos. Lo define el contrato del dealer: el sistema no lo calcula solo." />
      <StackPanel Orientation="Horizontal">
        <TextBox x:Name="CajaPorcentaje" Width="90" Height="34"
                 Style="{DynamicResource Input.Texto}"
                 TextChanged="Porcentaje_TextChanged" />
        <TextBlock Text="%" VerticalAlignment="Center" Margin="8,0,0,0"
                   Style="{DynamicResource Texto.CuerpoEnfatizado}" />
      </StackPanel>
      <CheckBox x:Name="CasillaFijar" FontSize="12" Margin="0,10,0,0"
                Content="Usar siempre este porcentaje (se puede cambiar en cada cancelación)" />

      <!-- Cómo queda la plata, en vivo -->
      <Border Margin="0,14,0,0" CornerRadius="8" Padding="14,12"
              Background="{DynamicResource Brush.PrimarioSutil}">
        <StackPanel>
          <TextBlock x:Name="TextoCobrado" Style="{DynamicResource Texto.Caption}" />
          <TextBlock x:Name="TextoRetenido" Style="{DynamicResource Texto.CuerpoEnfatizado}"
                     Margin="0,4,0,0" />
          <TextBlock x:Name="TextoDevuelto" Style="{DynamicResource Texto.CuerpoEnfatizado}" />
        </StackPanel>
      </Border>

      <TextBlock x:Name="TextoError" Style="{DynamicResource Texto.Caption}"
                 Foreground="{DynamicResource Brush.Destructivo}"
                 TextWrapping="Wrap" Margin="0,10,0,0" />

      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="Cancelar la venta"
                Style="{DynamicResource Boton.Destructivo}" Click="Confirmar_Click" />
        <Button Grid.Column="2" Content="Volver" Style="{DynamicResource Boton.Secundario}"
                IsCancel="True" Click="Volver_Click" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
