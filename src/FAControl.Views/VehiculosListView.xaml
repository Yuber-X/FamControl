<UserControl x:Class="FAControl.Views.VehiculosListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <Button DockPanel.Dock="Right" Content="+ Nuevo vehículo"
              Style="{DynamicResource Boton.Primario}"
              Visibility="{Binding PuedeEditar, Converter={StaticResource BoolAVisibilidad}}"
              Command="{Binding NuevoCommand}" />
      <StackPanel Orientation="Horizontal">
        <TextBox Width="320"
                 Style="{DynamicResource Input.Texto}"
                 Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Buscar por código, marca, modelo o placa" />
        <ComboBox Width="180" Height="40" FontSize="13" Margin="12,0,0,0"
                  ItemsSource="{Binding Filtros}"
                  SelectedItem="{Binding FiltroSeleccionado}" />
      </StackPanel>
    </DockPanel>

    <!-- Tabla -->
    <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="0">
      <DataGrid Style="{DynamicResource Tabla}"
                ItemsSource="{Binding Filas}"
                MouseDoubleClick="Tabla_MouseDoubleClick">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="90">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource Fuente.Mono}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Vehículo" Binding="{Binding Descripcion}" Width="*" MinWidth="180"
                              HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
          <DataGridTextColumn Header="Tipo" Binding="{Binding TipoTexto}" Width="110" MinWidth="100" />
          <DataGridTextColumn Header="Placa" Binding="{Binding PlacaTexto}" Width="100" />
          <DataGridTextColumn Header="Costo total"
                              Binding="{Binding CostoTotal, Converter={StaticResource Money}}"
                              Width="140" MinWidth="130">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Precio venta"
                              Binding="{Binding PrecioVenta, Converter={StaticResource Money}}"
                              Width="140" MinWidth="130">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Ganancia"
                              Binding="{Binding GananciaEstimada, Converter={StaticResource Money}}"
                              Width="140" MinWidth="130">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="120" MinWidth="110" />
          <DataGridTemplateColumn Width="180">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding DataContext.PuedeEditar,
                                        RelativeSource={RelativeSource AncestorType=DataGrid},
                                        Converter={StaticResource BoolAVisibilidad}}">
                  <Button Content="Editar" Style="{DynamicResource Boton.Terciario}"
                          Command="{Binding DataContext.EditarCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}" />
                  <Button Content="Eliminar" Style="{DynamicResource Boton.Terciario}"
                          Margin="4,0,0,0"
                          Command="{Binding DataContext.EliminarCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <TextBlock Grid.Row="2" Text="{Binding ContadorTexto}"
               Style="{DynamicResource Texto.Caption}" Margin="4,10,0,0" />
  </Grid>
</UserControl>
