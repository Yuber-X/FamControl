<Window x:Class="FAControl.Views.ContratosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contratos"
        Width="940" Height="860"
        MinWidth="560" MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.FondoApp}">

  <!-- ===================== CONTRATOS DEL PRÉSTAMO =====================
       Pedido del cliente 2026-09-03: el botón dejó de abrir directo el pagaré
       y ahora ofrece los TRES documentos, cada uno con su vista previa y su
       impresión.

       Los selectores son ToggleButton y no pestañas para que se vea de una
       cuál está en pantalla incluso a un metro de distancia, que es como se
       usa esto: el cajero elige, mira y manda a imprimir. -->
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ===== Los tres documentos ===== -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
      <ToggleButton x:Name="BotonPagare" Style="{DynamicResource Toggle.Segmento}"
                    Content="Pagaré" Click="Seleccionar_Click" Tag="0" />
      <ToggleButton x:Name="BotonNotarial" Style="{DynamicResource Toggle.Segmento}"
                    Content="Pagaré notarial" Margin="8,0,0,0" Click="Seleccionar_Click" Tag="1" />
      <ToggleButton x:Name="BotonCombinado" Style="{DynamicResource Toggle.Segmento}"
                    Content="Notarial + cuotas" Margin="8,0,0,0" Click="Seleccionar_Click" Tag="2" />

      <TextBlock x:Name="Descripcion" VerticalAlignment="Center" Margin="16,0,0,0"
                 Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" MaxWidth="330" />
    </StackPanel>

    <!-- ===== Vista previa ===== -->
    <Border Grid.Row="1" Background="{DynamicResource Brush.FondoApp}" CornerRadius="8"
            BorderBrush="{DynamicResource Brush.BordeEstandar}" BorderThickness="1">
      <FlowDocumentPageViewer x:Name="Visor" Background="Transparent"
                              Zoom="100" MinZoom="50" MaxZoom="300" />
    </Border>

    <!-- ===== Aviso de datos faltantes ===== -->
    <DockPanel Grid.Row="2" Margin="0,14,0,0">
      <Border x:Name="AvisoFaltantes" DockPanel.Dock="Top" Visibility="Collapsed"
              Background="{DynamicResource Brush.Aviso.Fondo}" CornerRadius="8"
              Padding="12,9" Margin="0,0,0,12">
        <TextBlock x:Name="TextoFaltantes" TextWrapping="Wrap"
                   Style="{DynamicResource Texto.Caption}" />
      </Border>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="&#xE71F;" FontFamily="Segoe MDL2 Assets" Width="34" Height="34"
                Style="{DynamicResource Boton.Terciario}" ToolTip="Alejar" Click="BotonAlejar_Click" />
        <TextBlock x:Name="EtiquetaZoom" Text="100%" VerticalAlignment="Center"
                   MinWidth="52" TextAlignment="Center" Style="{DynamicResource Texto.Cuerpo}" />
        <Button Content="&#xE8A3;" FontFamily="Segoe MDL2 Assets" Width="34" Height="34"
                Style="{DynamicResource Boton.Terciario}" ToolTip="Acercar" Click="BotonAcercar_Click" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Guardar PDF" Style="{DynamicResource Boton.Secundario}" MinWidth="120"
                Click="BotonGuardarPdf_Click" />
        <Button x:Name="BotonImprimir" Content="Imprimir" Style="{DynamicResource Boton.Primario}"
                MinWidth="140" Margin="8,0,0,0" Click="BotonImprimir_Click" />
        <Button Content="Cerrar" Style="{DynamicResource Boton.Secundario}" MinWidth="100"
                Margin="8,0,0,0" Click="BotonCerrar_Click" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
