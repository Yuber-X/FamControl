<UserControl x:Class="FAControl.Views.PrestamoNuevoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="420" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============ FORMULARIO ============ -->
    <Border Grid.Column="0" Style="{DynamicResource Card}" Margin="0,0,12,0"
            VerticalAlignment="Top">
      <!-- Padding derecho: aire entre los inputs y el scrollbar -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620" Padding="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Datos del préstamo" Style="{DynamicResource Texto.Titulo3}"
                     Margin="0,0,0,16" />

          <!-- AutoControl: vehículo a financiar (solo en modo vehicular) -->
          <StackPanel Visibility="{Binding EsVehicular, Converter={StaticResource BoolAVisibilidad}}"
                      Margin="0,0,0,14">
            <TextBlock Text="Vehículo a financiar (en garantía)" Style="{DynamicResource Input.Label}" />
            <ComboBox Height="40" FontSize="13"
                      ItemsSource="{Binding VehiculosDisponibles}"
                      SelectedItem="{Binding VehiculoSeleccionado}">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Descripcion}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <TextBlock Text="Cliente" Style="{DynamicResource Input.Label}" />
          <ComboBox Height="40" FontSize="13"
                    ItemsSource="{Binding Clientes}"
                    SelectedItem="{Binding ClienteSeleccionado}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding NombreCompleto}" FontWeight="Medium" />
                  <TextBlock Text="{Binding Cedula, StringFormat=' — {0}'}"
                             Foreground="{DynamicResource Brush.TextoTerciario}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Text="Monto del capital (RD$)" Style="{DynamicResource Input.Label}"
                     Margin="0,14,0,6" />
          <TextBox Style="{DynamicResource Input.Texto}"
                   Text="{Binding MontoTexto, UpdateSourceTrigger=PropertyChanged}" />

          <!-- Modalidad primero: define si hay plazo/método o es pago único -->
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Modalidad de pago" Style="{DynamicResource Input.Label}" />
              <ComboBox Height="40" FontSize="13"
                        ItemsSource="{Binding Modalidades}"
                        SelectedItem="{Binding ModalidadSeleccionada}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <!-- Etiqueta cambia a "Fecha del pago" en pago único -->
              <TextBlock Text="{Binding EtiquetaFecha}" Style="{DynamicResource Input.Label}" />
              <DatePicker Height="40" FontSize="13"
                          SelectedDate="{Binding FechaPrimerPago}" />
            </StackPanel>
          </Grid>

          <!-- Modo "para bobos": el sistema calcula la tasa desde el total -->
          <CheckBox Content="Calcular la tasa por mí (ingreso el total a devolver)"
                    FontSize="12" Margin="0,14,0,0"
                    IsChecked="{Binding ModoMontoFinal}" />

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tasa manual (modo normal) -->
            <StackPanel Grid.Column="0"
                        Visibility="{Binding MuestraTasaManual, Converter={StaticResource BoolAVisibilidad}}">
              <TextBlock Text="Tasa mensual (%)" Style="{DynamicResource Input.Label}" />
              <TextBox Style="{DynamicResource Input.Texto}"
                       Text="{Binding TasaTexto, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- Monto final a devolver (modo "para bobos") -->
            <StackPanel Grid.Column="0">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ModoMontoFinal}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="Total a devolver (RD$)" Style="{DynamicResource Input.Label}" />
              <TextBox Style="{DynamicResource Input.Texto}"
                       Text="{Binding MontoFinalTexto, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- Cuotas: oculto en pago único (siempre 1) -->
            <StackPanel Grid.Column="2"
                        Visibility="{Binding MuestraPlazoYMetodo, Converter={StaticResource BoolAVisibilidad}}">
              <TextBlock Text="Cantidad de cuotas" Style="{DynamicResource Input.Label}" />
              <TextBox Style="{DynamicResource Input.Texto}"
                       Text="{Binding PlazoTexto, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Grid>

          <!-- Pista de la tasa calculada en modo "para bobos" -->
          <TextBlock Text="{Binding TasaCalculadaTexto}"
                     Foreground="{DynamicResource Brush.Primario}"
                     Style="{DynamicResource Texto.Caption}" Margin="0,6,0,0" />

          <!-- Método: oculto en pago único (una cuota, da igual el método) -->
          <StackPanel Visibility="{Binding MuestraPlazoYMetodo, Converter={StaticResource BoolAVisibilidad}}">
            <TextBlock Text="Método de cálculo" Style="{DynamicResource Input.Label}"
                       Margin="0,14,0,6" />
            <ComboBox Height="40" FontSize="13"
                      ItemsSource="{Binding Metodos}"
                      SelectedItem="{Binding MetodoSeleccionado}" />
            <!-- Explica el método elegido. Con Style: sin él el texto sale negro
                 y desaparece en modo noche. -->
            <TextBlock Text="{Binding MetodoAyudaTexto}" TextWrapping="Wrap"
                       Style="{DynamicResource Texto.Caption}" Margin="0,6,0,0" />

            <!-- Solo para "interés fijo primero, capital después" (2026-08-06):
                 dónde arranca el capital. Automático = un tercio del plazo;
                 manual = el usuario escribe la cuota exacta. -->
            <Border Background="{DynamicResource Brush.PrimarioSutil}" CornerRadius="10"
                    Padding="14,12" Margin="0,10,0,0"
                    Visibility="{Binding EsCapitalDiferido, Converter={StaticResource BoolAVisibilidad}}">
              <StackPanel>
                <TextBlock Text="¿DESDE QUÉ CUOTA SE COBRA EL CAPITAL?"
                           Style="{DynamicResource Texto.MicroLabel}" />
                <RadioButton Content="Que lo decida el sistema" Margin="0,8,0,0"
                             GroupName="InicioCapital"
                             IsChecked="{Binding InicioCapitalAutomatico, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <RadioButton Content="Elegir la cuota:" VerticalAlignment="Center"
                               GroupName="InicioCapital"
                               IsChecked="{Binding InicioCapitalManual, Mode=TwoWay}" />
                  <TextBox Width="70" Margin="10,0,0,0" Style="{DynamicResource Input.Texto}"
                           IsEnabled="{Binding InicioCapitalAutomatico,
                                       Converter={StaticResource InversorBool}}"
                           Text="{Binding InicioCapitalTexto, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <TextBlock Text="{Binding InicioCapitalAyuda}" TextWrapping="Wrap"
                           Style="{DynamicResource Texto.Caption}" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>

          <TextBlock Text="Garantía (opcional)" Style="{DynamicResource Input.Label}"
                     Margin="0,14,0,6" />
          <TextBox Style="{DynamicResource Input.Texto}"
                   Text="{Binding Garantia, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="Notas (opcional)" Style="{DynamicResource Input.Label}"
                     Margin="0,14,0,6" />
          <TextBox Style="{DynamicResource Input.Texto}" Height="64"
                   TextWrapping="Wrap" AcceptsReturn="True"
                   VerticalContentAlignment="Top" Padding="10,8"
                   Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" />

          <!-- Comprobante fiscal (pedido 2026-07-25) -->
          <TextBlock Text="Comprobante fiscal — NCF (opcional)" Style="{DynamicResource Input.Label}"
                     Margin="0,14,0,6" />
          <TextBox Style="{DynamicResource Input.Texto}"
                   IsEnabled="{Binding NcfDeSecuencia, Converter={StaticResource InversorBool}}"
                   Text="{Binding NcfTexto, UpdateSourceTrigger=PropertyChanged}" />
          <CheckBox Style="{DynamicResource Switch.Moderno}" Margin="0,10,0,0"
                    Content="Tomar el siguiente de la secuencia configurada (Configuración → Comprobante fiscal)"
                    IsChecked="{Binding NcfDeSecuencia}" />

          <!-- Préstamo antiguo autodetectado (pedido 2026-07-25) -->
          <Border Background="{DynamicResource Brush.Aviso.Fondo}" CornerRadius="8" Padding="12,10" Margin="0,14,0,0"
                  Visibility="{Binding EsPrestamoAntiguo, Converter={StaticResource BoolAVisibilidad}}">
            <StackPanel>
              <TextBlock Text="{Binding PrestamoAntiguoTexto}" FontSize="12.5" FontWeight="SemiBold"
                         TextWrapping="Wrap" Foreground="{DynamicResource Brush.Aviso.Texto}" />
              <CheckBox Content="El cliente está al día (marcar TODAS las cuotas vencidas como pagadas)"
                        FontSize="12" Margin="0,8,0,0"
                        IsChecked="{Binding ClienteAlDia}" />
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                          IsEnabled="{Binding ClienteAlDia, Converter={StaticResource InversorBool}}">
                <TextBlock Text="Cuotas que ya pagó:" FontSize="12" VerticalAlignment="Center" />
                <TextBox Width="70" Height="30" Margin="8,0,0,0" Style="{DynamicResource Input.Texto}"
                         Text="{Binding CuotasPagadasTexto, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="(se marcan desde la primera, con recibos históricos)"
                           FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                           Style="{DynamicResource Texto.Caption}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding MensajeValidacion}"
                     Foreground="{DynamicResource Brush.Destructivo}"
                     Style="{DynamicResource Texto.Caption}"
                     TextWrapping="Wrap" Margin="0,10,0,0" />

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Crear préstamo" Style="{DynamicResource Boton.Primario}"
                    Command="{Binding GuardarCommand}" />
            <!-- Ver el pagaré antes de crear, para revisarlo con el cliente -->
            <Button Grid.Column="2" Content="Ver pagaré" Style="{DynamicResource Boton.Secundario}"
                    Command="{Binding VerPagareCommand}" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- ============ PREVIEW EN VIVO ============ -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Resumen -->
      <UniformGrid Grid.Row="0" Rows="1" Columns="4" Margin="0,0,0,12"
                   Visibility="{Binding TienePreview, Converter={StaticResource BoolAVisibilidad}}">
        <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="CUOTA" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding ResumenCuota, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Titulo2}" />
            </Viewbox>
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="TOTAL A PAGAR" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding ResumenTotal, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Titulo2}" />
            </Viewbox>
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="INTERÉS TOTAL" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding ResumenInteres, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Titulo2}" />
            </Viewbox>
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Card.Metrica}">
          <StackPanel>
            <TextBlock Text="CAPITAL" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding ResumenCapital, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Titulo2}" />
            </Viewbox>
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Tabla de amortización -->
      <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="0">
        <Grid>
          <TextBlock Text="Completá el formulario para ver la tabla de amortización."
                     HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Caption}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding TienePreview}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <DataGrid Style="{DynamicResource Tabla}" ItemsSource="{Binding Preview}"
                    Visibility="{Binding TienePreview, Converter={StaticResource BoolAVisibilidad}}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="N°" Binding="{Binding NumeroCuota}" Width="50" MinWidth="50" />
              <DataGridTextColumn Header="Vencimiento"
                                  Binding="{Binding FechaVencimiento, StringFormat=dd/MM/yyyy}" Width="110" MinWidth="110" />
              <DataGridTextColumn Header="Capital"
                                  Binding="{Binding Capital, Converter={StaticResource Money}}" Width="*" MinWidth="130">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Interés"
                                  Binding="{Binding Interes, Converter={StaticResource Money}}" Width="*" MinWidth="130">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Cuota"
                                  Binding="{Binding MontoTotal, Converter={StaticResource Money}}" Width="*" MinWidth="130">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.MontoTotal}" />
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Saldo restante"
                                  Binding="{Binding SaldoDespues, Converter={StaticResource Money}}" Width="*" MinWidth="130">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
