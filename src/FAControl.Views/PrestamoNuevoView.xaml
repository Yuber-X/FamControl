<UserControl x:Class="FAControl.Views.PrestamoNuevoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:FAControl.Views"
             xmlns:m="clr-namespace:FAControl.Models;assembly=FAControl.Models">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="420" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============ FORMULARIO ============ -->
    <Border Grid.Column="0" Style="{DynamicResource Card}" Margin="0,0,12,0"
            VerticalAlignment="Top">
      <!-- Padding derecho: aire entre los inputs y el scrollbar -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620" Padding="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Datos del préstamo" Style="{DynamicResource Texto.Titulo3}"
                     Margin="0,0,0,16" />

          <!-- AutoControl: vehículo a financiar (solo en modo vehicular) -->
          <StackPanel Visibility="{Binding EsVehicular, Converter={StaticResource BoolAVisibilidad}}"
                      Margin="0,0,0,14">
            <TextBlock Text="Vehículo a financiar (en garantía)" Style="{DynamicResource Input.Label}" />
            <ComboBox Height="40" FontSize="13"
                      ItemsSource="{Binding VehiculosDisponibles}"
                      SelectedItem="{Binding VehiculoSeleccionado}">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Descripcion}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <TextBlock Text="Cliente" Style="{DynamicResource Input.Label}" />
          <ComboBox Height="40" FontSize="13"
                    ItemsSource="{Binding Clientes}"
                    SelectedItem="{Binding ClienteSeleccionado}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding NombreCompleto}" FontWeight="Medium" />
                  <TextBlock Text="{Binding Cedula, StringFormat=' — {0}'}"
                             Foreground="{DynamicResource Brush.TextoTerciario}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Text="Monto del capital (RD$)" Style="{DynamicResource Input.Label}"
                     Margin="0,14,0,6" />
          <TextBox Style="{DynamicResource Input.Texto}"
                   Text="{Binding MontoTexto, UpdateSourceTrigger=PropertyChanged}" />

          <!-- Modalidad primero: define si hay plazo/método o es pago único -->
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Modalidad de pago" Style="{DynamicResource Input.Label}" />
              <ComboBox Height="40" FontSize="13"
                        ItemsSource="{Binding Modalidades}"
                        SelectedItem="{Binding ModalidadSeleccionada}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <!-- Etiqueta cambia a "Fecha del pago" en pago único -->
              <TextBlock Text="{Binding EtiquetaFecha}" Style="{DynamicResource Input.Label}" />
              <DatePicker Height="40" FontSize="13"
                          SelectedDate="{Binding FechaPrimerPago}" />
            </StackPanel>
          </Grid>

          <!-- Modo "para bobos": el sistema calcula la tasa desde el total -->
          <CheckBox Style="{DynamicResource Switch.Moderno}" Content="Calcular la tasa por mí (ingreso el total a devolver)"
                    FontSize="12" Margin="0,14,0,0"
                    IsChecked="{Binding ModoMontoFinal}" />

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tasa manual (modo normal) -->
            <StackPanel Grid.Column="0"
                        Visibility="{Binding MuestraTasaManual, Converter={StaticResource BoolAVisibilidad}}">
              <TextBlock Text="Tasa mensual (%)" Style="{DynamicResource Input.Label}" />
              <TextBox Style="{DynamicResource Input.Texto}"
                       Text="{Binding TasaTexto, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- Monto final a devolver (modo "para bobos") -->
            <StackPanel Grid.Column="0">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ModoMontoFinal}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="Total a devolver (RD$)" Style="{DynamicResource Input.Label}" />
              <TextBox Style="{DynamicResource Input.Texto}"
                       Text="{Binding MontoFinalTexto, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- Cuotas: oculto en pago único (siempre 1) -->
            <StackPanel Grid.Column="2"
                        Visibility="{Binding MuestraPlazoYMetodo, Converter={StaticResource BoolAVisibilidad}}">
              <TextBlock Text="Cantidad de cuotas" Style="{DynamicResource Input.Label}" />
              <TextBox Style="{DynamicResource Input.Texto}"
                       Text="{Binding PlazoTexto, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Grid>

          <!-- Pista de la tasa calculada en modo "para bobos" -->
          <TextBlock Text="{Binding TasaCalculadaTexto}"
                     Foreground="{DynamicResource Brush.Primario}"
                     Style="{DynamicResource Texto.Caption}" Margin="0,6,0,0" />

          <!-- Método: oculto en pago único (una cuota, da igual el método) -->
          <StackPanel Visibility="{Binding MuestraPlazoYMetodo, Converter={StaticResource BoolAVisibilidad}}">
            <TextBlock Text="Método de cálculo" Style="{DynamicResource Input.Label}"
                       Margin="0,14,0,6" />
            <ComboBox Height="40" FontSize="13"
                      ItemsSource="{Binding Metodos}"
                      SelectedItem="{Binding MetodoSeleccionado}" />
            <!-- Explica el método elegido. Con Style: sin él el texto sale negro
                 y desaparece en modo noche. -->
            <TextBlock Text="{Binding MetodoAyudaTexto}" TextWrapping="Wrap"
                       Style="{DynamicResource Texto.Caption}" Margin="0,6,0,0" />

            <!-- Solo para "interés fijo primero, capital después" (2026-08-06):
                 dónde arranca el capital. Automático = un tercio del plazo;
                 manual = el usuario escribe la cuota exacta. -->
            <Border Background="{DynamicResource Brush.PrimarioSutil}" CornerRadius="10"
                    Padding="14,12" Margin="0,10,0,0"
                    Visibility="{Binding EsCapitalDiferido, Converter={StaticResource BoolAVisibilidad}}">
              <StackPanel>
                <TextBlock Text="¿DESDE QUÉ CUOTA SE COBRA EL CAPITAL?"
                           Style="{DynamicResource Texto.MicroLabel}" />
                <RadioButton Content="Que lo decida el sistema" Margin="0,8,0,0"
                             GroupName="InicioCapital"
                             IsChecked="{Binding InicioCapitalAutomatico, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <RadioButton Content="Elegir la cuota:" VerticalAlignment="Center"
                               GroupName="InicioCapital"
                               IsChecked="{Binding InicioCapitalManual, Mode=TwoWay}" />
                  <TextBox Width="70" Margin="10,0,0,0" Style="{DynamicResource Input.Texto}"
                           IsEnabled="{Binding InicioCapitalAutomatico,
                                       Converter={StaticResource InversorBool}}"
                           Text="{Binding InicioCapitalTexto, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <TextBlock Text="{Binding InicioCapitalAyuda}" TextWrapping="Wrap"
                           Style="{DynamicResource Texto.Caption}" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>

          <TextBlock Text="Garantía (opcional)" Style="{DynamicResource Input.Label}"
                     Margin="0,14,0,6" />
          <TextBox Style="{DynamicResource Input.Texto}"
                   Text="{Binding Garantia, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="Notas (opcional)" Style="{DynamicResource Input.Label}"
                     Margin="0,14,0,6" />
          <TextBox Style="{DynamicResource Input.Texto}" Height="64"
                   TextWrapping="Wrap" AcceptsReturn="True"
                   VerticalContentAlignment="Top" Padding="10,8"
                   Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" />

          <!-- Comprobante fiscal (pedido 2026-07-25) -->
          <TextBlock Text="Comprobante fiscal — NCF (opcional)" Style="{DynamicResource Input.Label}"
                     Margin="0,14,0,6" />
          <TextBox Style="{DynamicResource Input.Texto}"
                   ToolTip="Pega el e-NCF del Facturador Gratuito DGII, o enciende el switch para tomar el siguiente de la secuencia"
                   IsEnabled="{Binding NcfDeSecuencia, Converter={StaticResource InversorBool}}"
                   v:Marcador.Texto="{Binding NcfMarcador}"
                   Text="{Binding NcfTexto, UpdateSourceTrigger=PropertyChanged}" />
          <CheckBox Style="{DynamicResource Switch.Moderno}" Margin="0,10,0,0"
                    Content="{Binding NcfSwitchTexto}"
                    IsEnabled="{Binding HayNcfConfigurado}"
                    IsChecked="{Binding NcfDeSecuencia}" />

          <!-- Préstamo antiguo autodetectado (pedido 2026-07-25) -->
          <Border Background="{DynamicResource Brush.Aviso.Fondo}" CornerRadius="8" Padding="12,10" Margin="0,14,0,0"
                  Visibility="{Binding EsPrestamoAntiguo, Converter={StaticResource BoolAVisibilidad}}">
            <StackPanel>
              <TextBlock Text="{Binding PrestamoAntiguoTexto}" FontSize="12.5" FontWeight="SemiBold"
                         TextWrapping="Wrap" Foreground="{DynamicResource Brush.Aviso.Texto}" />
              <CheckBox Style="{DynamicResource Switch.Moderno}" Content="El cliente está al día (marcar TODAS las cuotas vencidas como pagadas)"
                        FontSize="12" Margin="0,8,0,0"
                        IsChecked="{Binding ClienteAlDia}" />
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                          IsEnabled="{Binding ClienteAlDia, Converter={StaticResource InversorBool}}">
                <TextBlock Text="Cuotas que ya pagó:" FontSize="12" VerticalAlignment="Center" />
                <TextBox Width="70" Height="30" Margin="8,0,0,0" Style="{DynamicResource Input.Texto}"
                         Text="{Binding CuotasPagadasTexto, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="(se marcan desde la primera, con recibos históricos)"
                           FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                           Style="{DynamicResource Texto.Caption}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding MensajeValidacion}"
                     Foreground="{DynamicResource Brush.Destructivo}"
                     Style="{DynamicResource Texto.Caption}"
                     TextWrapping="Wrap" Margin="0,10,0,0" />

          <!-- ============ PAGARÉ NOTARIAL (044) ============
               Todos los datos del acta, en un solo lugar (pedido del cliente
               2026-09-04). Los que casi nunca cambian —notario, quien firma por
               la empresa, testigos, asiento social y condiciones— vienen
               precargados desde Configuración → Pagaré notarial.

               TODO es opcional: lo que quede vacío sale como una raya en el
               documento, para llenarlo a mano. Es como se trabaja con un
               notario, y bloquear la impresión por un campo vacío sería peor.

               La rejilla de 3 columnas se genera por script para que las ~30
               celdas queden con el mismo alto y el mismo margen. -->
          <Expander Margin="0,18,0,0" IsExpanded="False">
            <Expander.Header>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Datos del pagaré notarial" Style="{DynamicResource Texto.Titulo3}" />
                <TextBlock Text="(opcional)" Margin="8,0,0,0" VerticalAlignment="Center"
                           Style="{DynamicResource Texto.Caption}" />
              </StackPanel>
            </Expander.Header>

            <StackPanel Margin="0,10,0,0">
              <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                         Text="Lo que quede vacío sale como una raya en el acta, para llenarlo a mano. El notario, quien firma por la empresa y los testigos vienen de Configuración; si los cambiás aquí, el cambio vale solo para este préstamo." />

              <!-- El interruptor convierte el cambio puntual en el nuevo valor
                   del negocio. Apagado por defecto: lo normal es corregir un
                   dato para ESTE contrato, no para todos los que vengan. -->
              <CheckBox Style="{DynamicResource Switch.Moderno}" Margin="0,4,0,2"
                        Content="Guardar estos datos en Configuración (reemplazan a los actuales)"
                        ToolTip="Al crear el préstamo, el notario, el representante, los testigos y las condiciones de arriba pasan a ser los del negocio"
                        IsChecked="{Binding GuardarNotarialEnConfiguracion}" />

        <TextBlock Text="EL ACTO" Style="{DynamicResource Texto.MicroLabel}" Margin="0,10,0,6" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
            <TextBlock Text="Acto No." Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                           Text="{Binding ActoNo, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,8">
            <TextBlock Text="Folio No." Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                           Text="{Binding FolioNo, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,8">
            <TextBlock Text="Fecha del acto" Style="{DynamicResource Input.Label}" />
            <DatePicker Height="32" SelectedDate="{Binding FechaActo}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,10,8">
            <TextBlock Text="Municipio del acto" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                             ToolTip="Ciudad, municipio y provincia donde se firma"
                           Text="{Binding MunicipioActo, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>

        <TextBlock Text="EL DEUDOR, COMO LO DESCRIBE EL ACTA" Style="{DynamicResource Texto.MicroLabel}" Margin="0,10,0,6" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
            <TextBlock Text="Sexo" Style="{DynamicResource Input.Label}" />
            <ComboBox Height="32" ItemsSource="{Binding Sexos}" DisplayMemberPath="Texto"
                            SelectedItem="{Binding DeudorSexo}"
                             ToolTip="El acta se escribe en masculino o femenino según esto: dominicano/a, EL DEUDOR / LA DEUDORA" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,8">
            <TextBlock Text="Nacionalidad" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                             v:Marcador.Texto="dominicano"
                           Text="{Binding DeudorNacionalidad, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,8">
            <TextBlock Text="Estado civil" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                             v:Marcador.Texto="soltero, casado…"
                           Text="{Binding DeudorEstadoCivil, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,10,8">
            <TextBlock Text="Ocupación" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                             v:Marcador.Texto="comerciante, empleado…"
                           Text="{Binding DeudorOcupacion, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>

        <TextBlock Text="EL NOTARIO" Style="{DynamicResource Texto.MicroLabel}" Margin="0,10,0,6" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,10,8">
            <TextBlock Text="Nombre" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                           Text="{Binding NotarioNombre, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,8">
            <TextBlock Text="Matrícula" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                             ToolTip="Matrícula del Colegio Dominicano de Notarios"
                           Text="{Binding NotarioMatricula, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,8">
            <TextBlock Text="Cédula" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                           Text="{Binding NotarioCedula, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,10,8">
            <TextBlock Text="Estado civil" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                             v:Marcador.Texto="soltero, casado…"
                           Text="{Binding NotarioEstadoCivil, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,10,8">
            <TextBlock Text="Domicilio profesional" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                           Text="{Binding NotarioDomicilio, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>

        <TextBlock Text="QUIEN FIRMA POR LA EMPRESA" Style="{DynamicResource Texto.MicroLabel}" Margin="0,10,0,6" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,10,8">
            <TextBlock Text="Nombre" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                           Text="{Binding RepresentanteNombre, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,8">
            <TextBlock Text="Cédula" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                           Text="{Binding RepresentanteCedula, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,8">
            <TextBlock Text="Estado civil" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                             v:Marcador.Texto="soltero, casado…"
                           Text="{Binding RepresentanteEstadoCivil, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,8">
            <TextBlock Text="Ocupación" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                           Text="{Binding RepresentanteOcupacion, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <CheckBox Grid.Row="1" Grid.Column="2" Style="{DynamicResource Switch.Moderno}"
                    Margin="0,18,10,8" FontSize="12"
                    Content="Es mujer" IsChecked="{Binding RepresentanteEsFemenino}" />
          <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,10,8">
            <TextBlock Text="Domicilio" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                           Text="{Binding RepresentanteDomicilio, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>

        <TextBlock Text="TESTIGO 1" Style="{DynamicResource Texto.MicroLabel}" Margin="0,10,0,6" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,10,8">
            <TextBlock Text="Nombre" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                           Text="{Binding Testigo1Nombre, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,8">
            <TextBlock Text="Cédula" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                           Text="{Binding Testigo1Cedula, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,8">
            <TextBlock Text="Estado civil" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                             v:Marcador.Texto="soltero, casado…"
                           Text="{Binding Testigo1EstadoCivil, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,8">
            <TextBlock Text="Ocupación" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                           Text="{Binding Testigo1Ocupacion, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <CheckBox Grid.Row="1" Grid.Column="2" Style="{DynamicResource Switch.Moderno}"
                    Margin="0,18,10,8" FontSize="12"
                    Content="Es mujer" IsChecked="{Binding Testigo1EsFemenino}" />
          <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,10,8">
            <TextBlock Text="Domicilio" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                           Text="{Binding Testigo1Domicilio, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>

        <TextBlock Text="TESTIGO 2" Style="{DynamicResource Texto.MicroLabel}" Margin="0,10,0,6" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,10,8">
            <TextBlock Text="Nombre" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                           Text="{Binding Testigo2Nombre, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,8">
            <TextBlock Text="Cédula" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                           Text="{Binding Testigo2Cedula, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,8">
            <TextBlock Text="Estado civil" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                             v:Marcador.Texto="soltero, casado…"
                           Text="{Binding Testigo2EstadoCivil, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,8">
            <TextBlock Text="Ocupación" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                           Text="{Binding Testigo2Ocupacion, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <CheckBox Grid.Row="1" Grid.Column="2" Style="{DynamicResource Switch.Moderno}"
                    Margin="0,18,10,8" FontSize="12"
                    Content="Es mujer" IsChecked="{Binding Testigo2EsFemenino}" />
          <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,10,8">
            <TextBlock Text="Domicilio" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                           Text="{Binding Testigo2Domicilio, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>

        <TextBlock Text="LA EMPRESA" Style="{DynamicResource Texto.MicroLabel}" Margin="0,10,0,6" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,10,8">
            <TextBlock Text="Asiento social (dirección)" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                             ToolTip="Dirección completa, como la escribe el acta"
                           Text="{Binding NegocioDireccion, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>

        <TextBlock Text="CONDICIONES DEL CONTRATO" Style="{DynamicResource Texto.MicroLabel}" Margin="0,10,0,6" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
            <TextBlock Text="Cuotas en atraso que vencen el plazo" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                           Text="{Binding CuotasExigibilidadTexto, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,8">
            <TextBlock Text="Días de gracia" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                           Text="{Binding DiasGraciaTexto, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,8">
            <TextBlock Text="Mora (%)" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                           Text="{Binding MoraPorcentajeTexto, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,10,8">
            <TextBlock Text="Registro de Títulos" Style="{DynamicResource Input.Label}" />
            <TextBox Height="32" Style="{DynamicResource Input.Texto}"
                             ToolTip="El que se autoriza a ejecutar el traspaso de la garantía"
                           Text="{Binding RegistroTitulos, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>
            </StackPanel>
          </Expander>

          <!-- ============ QUÉ CONTRATOS SE IMPRIMEN (2026-09-03) ============
               Los tildados salen por la impresora al apretar "Guardar e
               imprimir"; los destildados no. La elección se recuerda por PC. -->
          <Border Style="{DynamicResource Card}" Margin="0,16,0,0" Padding="14,12">
            <StackPanel>
              <TextBlock Text="Contratos a imprimir" Style="{DynamicResource Texto.MicroLabel}"
                         Margin="0,0,0,8" />
              <WrapPanel>
                <CheckBox Style="{DynamicResource Switch.Moderno}" Margin="0,0,20,6"
                          Content="Pagaré" IsChecked="{Binding ImprimirPagare}"
                          ToolTip="El de siempre: encabezado del negocio, la deuda y la tabla de cuotas" />
                <CheckBox Style="{DynamicResource Switch.Moderno}" Margin="0,0,20,6"
                          Content="Pagaré notarial" IsChecked="{Binding ImprimirNotarial}"
                          ToolTip="El acta para firmar ante notario, con testigos y garantía" />
                <CheckBox Style="{DynamicResource Switch.Moderno}" Margin="0,0,0,6"
                          Content="Notarial + cuotas" IsChecked="{Binding ImprimirCombinado}"
                          ToolTip="El acta notarial y, atrás, la tabla de cuotas completa" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- ============ ACCIONES ============
               "Crear préstamo" guarda y nada más. "Crear e imprimir" guarda y
               manda a la impresora los contratos tildados. WrapPanel para que
               los tres botones bajen de renglón en una ventana angosta en vez
               de recortarse. -->
          <!-- Acciones: las dos de guardar comparten el ancho en la primera
               fila y "Ver contratos" toma el ancho completo en la segunda.
               Grid y no WrapPanel: el WrapPanel deja a los botones con su ancho
               natural y sobraba espacio a la derecha del formulario. -->
          <Grid Margin="0,18,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0"
                    Content="Crear préstamo" Style="{DynamicResource Boton.Primario}"
                    ToolTip="Guarda el préstamo y nada más"
                    Command="{Binding GuardarCommand}" />
            <Button Grid.Row="0" Grid.Column="2"
                    Content="Crear e imprimir" Style="{DynamicResource Boton.Primario}"
                    ToolTip="Crea el préstamo e imprime los contratos tildados. Las copias quedan en el expediente."
                    Command="{Binding GuardarEImprimirCommand}" />

            <Button Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0"
                    Content="Ver contratos" Style="{DynamicResource Boton.Secundario}"
                    ToolTip="Revisar los documentos con el cliente antes de crear el préstamo"
                    Command="{Binding VerPagareCommand}" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- ============ PREVIEW EN VIVO ============
         Por defecto muestra la tabla de amortización, que es lo que más se
         mira. Los tres botones de arriba cambian el panel por la vista previa
         del contrato correspondiente (2026-09-03); apretar el mismo botón otra
         vez vuelve a la tabla. -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Los tres reparten el ancho en partes iguales: el panel lateral es
           angosto y con ancho natural los textos quedaban apretados contra el
           borde. El estilo Toggle.Segmento centra y agranda el texto. -->
      <Grid Grid.Row="0" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ToggleButton Grid.Column="0" Style="{DynamicResource Toggle.Segmento}"
                      Content="Pagaré" Margin="0,0,8,0"
                      Command="{Binding VerEnLateralCommand}"
                      CommandParameter="{x:Static m:TipoContrato.Pagare}"
                      IsChecked="{Binding VistaPreviaTipo, Mode=OneWay,
                                  Converter={StaticResource Igualdad},
                                  ConverterParameter={x:Static m:TipoContrato.Pagare}}" />
        <ToggleButton Grid.Column="1" Style="{DynamicResource Toggle.Segmento}"
                      Content="Pagaré notarial" Margin="0,0,8,0"
                      Command="{Binding VerEnLateralCommand}"
                      CommandParameter="{x:Static m:TipoContrato.Notarial}"
                      IsChecked="{Binding VistaPreviaTipo, Mode=OneWay,
                                  Converter={StaticResource Igualdad},
                                  ConverterParameter={x:Static m:TipoContrato.Notarial}}" />
        <ToggleButton Grid.Column="2" Style="{DynamicResource Toggle.Segmento}"
                      Content="Notarial + cuotas" Margin="0"
                      Command="{Binding VerEnLateralCommand}"
                      CommandParameter="{x:Static m:TipoContrato.Combinado}"
                      IsChecked="{Binding VistaPreviaTipo, Mode=OneWay,
                                  Converter={StaticResource Igualdad},
                                  ConverterParameter={x:Static m:TipoContrato.Combinado}}" />
      </Grid>

      <!-- Vista previa del contrato elegido -->
      <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="0"
              Visibility="{Binding MuestraContratoLateral, Converter={StaticResource BoolAVisibilidad}}">
        <FlowDocumentScrollViewer x:Name="VisorContrato" Background="Transparent"
                                  VerticalScrollBarVisibility="Auto" Zoom="70" />
      </Border>

      <!-- Resumen -->
      <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,12"
                   Visibility="{Binding MuestraMetricas, Converter={StaticResource BoolAVisibilidad}}">
        <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="CUOTA" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding ResumenCuota, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Titulo2}" />
            </Viewbox>
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="TOTAL A PAGAR" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding ResumenTotal, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Titulo2}" />
            </Viewbox>
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="INTERÉS TOTAL" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding ResumenInteres, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Titulo2}" />
            </Viewbox>
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Card.Metrica}">
          <StackPanel>
            <TextBlock Text="CAPITAL" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding ResumenCapital, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Titulo2}" />
            </Viewbox>
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Tabla de amortización -->
      <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="0"
              Visibility="{Binding MuestraTablaLateral, Converter={StaticResource BoolAVisibilidad}}">
        <Grid>
          <TextBlock Text="Completa el formulario para ver la tabla de amortización."
                     HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Caption}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding TienePreview}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <DataGrid Style="{DynamicResource Tabla}" ItemsSource="{Binding Preview}"
                    Visibility="{Binding TienePreview, Converter={StaticResource BoolAVisibilidad}}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="N°" Binding="{Binding NumeroCuota}" Width="50" MinWidth="50" />
              <DataGridTextColumn Header="Vencimiento"
                                  Binding="{Binding FechaVencimiento, StringFormat=dd/MM/yyyy}" Width="110" MinWidth="110" />
              <DataGridTextColumn Header="Capital"
                                  Binding="{Binding Capital, Converter={StaticResource Money}}" Width="*" MinWidth="130">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Interés"
                                  Binding="{Binding Interes, Converter={StaticResource Money}}" Width="*" MinWidth="130">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Cuota"
                                  Binding="{Binding MontoTotal, Converter={StaticResource Money}}" Width="*" MinWidth="130">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.MontoTotal}" />
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Saldo restante"
                                  Binding="{Binding SaldoDespues, Converter={StaticResource Money}}" Width="*" MinWidth="130">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
