<UserControl x:Class="FAControl.Views.VentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <Button DockPanel.Dock="Right" Content="+ Nueva venta"
              Style="{DynamicResource Boton.Primario}"
              Visibility="{Binding PuedeEditar, Converter={StaticResource BoolAVisibilidad}}"
              Command="{Binding NuevoCommand}" />
      <TextBlock Text="Ventas de vehículos al contado" VerticalAlignment="Center"
                 Style="{DynamicResource Texto.Cuerpo}" />
    </DockPanel>

    <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="0">
      <DataGrid Style="{DynamicResource Tabla}" ItemsSource="{Binding Filas}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="90">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource Fuente.Mono}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Vehículo" Binding="{Binding Vehiculo}" Width="*" MinWidth="170"
                              HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
          <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*" MinWidth="150"
                              HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
          <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="120" />
          <DataGridTextColumn Header="Método" Binding="{Binding MetodoTexto}" Width="120" MinWidth="110" />
          <DataGridTextColumn Header="Tipo" Binding="{Binding TipoTexto}" Width="110" />
          <DataGridTextColumn Header="Precio"
                              Binding="{Binding Precio, Converter={StaticResource Money}}"
                              Width="160" MinWidth="140">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <!-- Facturación y financiamiento (pedido 2026-07-25) -->
          <DataGridTemplateColumn Width="180">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Factura" Style="{DynamicResource Boton.Terciario}"
                          Command="{Binding DataContext.VerFacturaCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}" />
                  <Button Content="Plazos" Style="{DynamicResource Boton.Terciario}" Margin="4,0,0,0"
                          Visibility="{Binding TienePlan, Converter={StaticResource BoolAVisibilidad}}"
                          Command="{Binding DataContext.VerPlazosCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <TextBlock Grid.Row="2" Text="{Binding ContadorTexto}"
               Style="{DynamicResource Texto.Caption}" Margin="4,10,0,0" />
  </Grid>
</UserControl>
