<UserControl x:Class="FAControl.Views.Pos.CaducidadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Resumen de urgencias -->
    <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,16" MaxWidth="620"
                 HorizontalAlignment="Left">
      <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="CRÍTICOS (1 MES O MENOS)" Style="{DynamicResource Texto.MicroLabel}" />
          <Viewbox Style="{DynamicResource Metrica.Valor}">
            <TextBlock Text="{Binding TotalRojos}" Style="{DynamicResource Texto.Display}"
  Foreground="{DynamicResource Brush.Destructivo}" />
          </Viewbox>
        </StackPanel>
      </Border>
      <Border Style="{DynamicResource Card.Metrica}">
        <StackPanel>
          <TextBlock Text="PRÓXIMOS (2–3 MESES)" Style="{DynamicResource Texto.MicroLabel}" />
          <Viewbox Style="{DynamicResource Metrica.Valor}">
            <TextBlock Text="{Binding TotalNaranjas}" Style="{DynamicResource Texto.Display}" />
          </Viewbox>
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Ordenado por proximidad; los más urgentes arriba -->
    <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="0">
      <DataGrid Style="{DynamicResource Tabla}" ItemsSource="{Binding Filas}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Código" Binding="{Binding CodigoTexto}" Width="130">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource Fuente.Mono}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" MinWidth="150"
                              HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
          <DataGridTextColumn Header="Stock" Binding="{Binding Cantidad}" Width="90">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Caducidad" Binding="{Binding CaducidadTexto}" Width="120">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTemplateColumn Header="Tiempo restante" Width="140"
                                  HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{DynamicResource Pill.Caducidad}" HorizontalAlignment="Left">
                  <TextBlock Style="{DynamicResource Pill.Caducidad.Texto}"
                             Text="{Binding SemaforoTexto}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <TextBlock Grid.Row="2" Text="{Binding ContadorTexto}"
               Style="{DynamicResource Texto.Caption}" Margin="4,10,0,0" />
  </Grid>
</UserControl>
