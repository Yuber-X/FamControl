<UserControl x:Class="FAControl.Views.Pos.ClientesListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <Button DockPanel.Dock="Right" Content="+ Nuevo cliente"
              Style="{DynamicResource Boton.Primario}"
              Visibility="{Binding PuedeEditar, Converter={StaticResource BoolAVisibilidad}}"
              Command="{Binding NuevoCommand}" />
      <TextBox Width="320" HorizontalAlignment="Left"
               Style="{DynamicResource Input.Texto}"
               Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Buscar por nombre, cédula o teléfono" />
    </DockPanel>

    <!-- Tabla -->
    <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="0">
      <DataGrid Style="{DynamicResource Tabla}" ItemsSource="{Binding Filas}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Cédula" Binding="{Binding CedulaTexto}" Width="140">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource Fuente.Mono}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" MinWidth="150"
                              HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
          <DataGridTextColumn Header="Teléfono" Binding="{Binding TelefonoTexto}" Width="130" />
          <DataGridTextColumn Header="Dirección" Binding="{Binding DireccionTexto}" Width="220"
                              HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
          <DataGridTemplateColumn Width="210">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Visibility="{Binding DataContext.PuedeEditar,
                                        RelativeSource={RelativeSource AncestorType=DataGrid},
                                        Converter={StaticResource BoolAVisibilidad}}">
                  <Button Content="Editar" Style="{DynamicResource Boton.Terciario}"
                          Command="{Binding DataContext.EditarCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}" />
                  <Button Content="Eliminar" Style="{DynamicResource Boton.Terciario}"
                          Foreground="{DynamicResource Brush.Destructivo}" Margin="8,0,0,0"
                          Command="{Binding DataContext.EliminarCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <TextBlock Grid.Row="2" Text="{Binding ContadorTexto}"
               Style="{DynamicResource Texto.Caption}" Margin="4,10,0,0" />
  </Grid>
</UserControl>
