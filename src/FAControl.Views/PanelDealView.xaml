<UserControl x:Class="FAControl.Views.PanelDealView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
    <StackPanel>

      <!-- KPIs del dealer (pedido 2026-07-25): solo datos de DealControl -->
      <UniformGrid Rows="1" Columns="4" Margin="0,0,0,12">
        <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0"
                Background="{DynamicResource Brush.Primario}">
          <StackPanel>
            <TextBlock Text="VEHÍCULOS DISPONIBLES" Style="{DynamicResource Texto.MicroLabel}"
                       Foreground="#C7CBFB" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding VehiculosDisponibles}"
                         Style="{DynamicResource Texto.Display}" Foreground="White" />
            </Viewbox>
            <TextBlock Text="{Binding AlquiladosTexto}" Style="{DynamicResource Texto.Caption}"
                       Foreground="#C7CBFB" />
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="INVERSIÓN EN INVENTARIO" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding CapitalInvertido, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Display}" />
            </Viewbox>
            <TextBlock Text="Costo + importación de lo no vendido" Style="{DynamicResource Texto.Caption}" />
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="VENTAS DEL MES" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding MontoVentasMes, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Display}" />
            </Viewbox>
            <TextBlock Text="{Binding VentasMesTexto}" Style="{DynamicResource Texto.Caption}" />
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Card.Metrica}">
          <StackPanel>
            <TextBlock Text="GANANCIA DEL MES (VENTAS)" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding GananciaVentasMes, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Display}" />
            </Viewbox>
            <TextBlock Text="Precio de venta menos costo total" Style="{DynamicResource Texto.Caption}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <UniformGrid Rows="1" Columns="2" Margin="0,0,0,12">
        <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="INGRESOS POR ALQUILER (MES)" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding IngresosAlquilerMes, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Display}" />
            </Viewbox>
            <TextBlock Text="{Binding AlquileresActivosTexto}" Style="{DynamicResource Texto.Caption}" />
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Card.Metrica}">
          <StackPanel>
            <TextBlock Text="RENT A CAR" Style="{DynamicResource Texto.MicroLabel}" />
            <Viewbox Style="{DynamicResource Metrica.Valor}">
              <TextBlock Text="{Binding AlquileresActivos}"
                         Style="{DynamicResource Texto.Display}" />
            </Viewbox>
            <TextBlock Text="Vehículos fuera en alquiler ahora mismo" Style="{DynamicResource Texto.Caption}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- ============ GRÁFICOS (pedido 2026-07-27) ============
           Izquierda: cómo viene el negocio mes a mes (ventas vs alquiler).
           Derecha: cuánto del inventario está parado ahora mismo. -->
      <Grid Margin="0,0,0,12" Height="280">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{DynamicResource Card}" Padding="20,14" Margin="0,0,12,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Ventas y alquiler — últimos 6 meses"
                       Style="{DynamicResource Texto.Titulo3}" Margin="0,0,0,8" />
            <lvc:CartesianChart Grid.Row="1"
                                Series="{Binding SeriesMeses}"
                                XAxes="{Binding MesesXAxes}"
                                YAxes="{Binding MesesYAxes}"
                                LegendPosition="Bottom" />
          </Grid>
        </Border>

        <Border Grid.Column="1" Style="{DynamicResource Card}" Padding="20,14">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Inventario ahora"
                       Style="{DynamicResource Texto.Titulo3}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Text="No hay vehículos en inventario."
                       Style="{DynamicResource Texto.Caption}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding SinInventario, Converter={StaticResource BoolAVisibilidad}}" />
            <lvc:PieChart Grid.Row="1" Series="{Binding SeriesInventario}"
                          Visibility="{Binding HayInventario, Converter={StaticResource BoolAVisibilidad}}" />
          </Grid>
        </Border>
      </Grid>

      <!-- Últimos movimientos -->
      <Border Style="{DynamicResource Card}" Padding="20,14">
        <StackPanel>
          <TextBlock Text="Últimos movimientos" Style="{DynamicResource Texto.Titulo3}" Margin="0,0,0,10" />
          <TextBlock Text="Todavía no hay ventas ni alquileres registrados."
                     Style="{DynamicResource Texto.Caption}"
                     Visibility="{Binding SinMovimientos, Converter={StaticResource BoolAVisibilidad}}" />
          <!-- Tabla real (antes era un ItemsControl con TextBlocks sin estilo:
               en modo noche el texto salía negro sobre fondo oscuro — fix
               2026-07-27). Estilo Tabla = colores del tema + alto de fila fijo
               + scroll horizontal cuando las columnas no caben. -->
          <DataGrid Style="{DynamicResource Tabla}" ItemsSource="{Binding Movimientos}"
                    MaxHeight="320"
                    Visibility="{Binding HayMovimientos, Converter={StaticResource BoolAVisibilidad}}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="90"
                                  HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
              <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="100">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{DynamicResource Fuente.Mono}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="110" />
              <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}"
                                  Width="Auto" MinWidth="170"
                                  HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
              <DataGridTextColumn Header="Vehículo" Binding="{Binding VehiculoDescripcion}"
                                  Width="Auto" MinWidth="190"
                                  HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
              <DataGridTextColumn Header="Monto" Width="150"
                                  Binding="{Binding Monto, Converter={StaticResource Money}}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
