<UserControl x:Class="FAControl.Views.VehiculoFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Formulario centrado, ancho máximo 680 -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Border Style="{DynamicResource Card}" MaxWidth="680" VerticalAlignment="Top"
            HorizontalAlignment="Center" Padding="32" Margin="0,8">
      <StackPanel>
        <TextBlock Text="{Binding Titulo}" Style="{DynamicResource Texto.Titulo2}"
                   Margin="0,0,0,20" />

        <!-- Marca / Modelo -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Marca" Style="{DynamicResource Input.Label}" />
            <TextBox Style="{DynamicResource Input.Texto}"
                     Text="{Binding Marca, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Modelo" Style="{DynamicResource Input.Label}" />
            <TextBox Style="{DynamicResource Input.Texto}"
                     Text="{Binding Modelo, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>

        <!-- Año / Tipo -->
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Año" Style="{DynamicResource Input.Label}" />
            <TextBox Style="{DynamicResource Input.Texto}"
                     Text="{Binding Anio, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Tipo" Style="{DynamicResource Input.Label}" />
            <ComboBox Height="40" FontSize="13"
                      ItemsSource="{Binding Tipos}"
                      SelectedItem="{Binding TipoSeleccionado}" />
          </StackPanel>
        </Grid>

        <!-- Color / Placa / Matrícula -->
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Color" Style="{DynamicResource Input.Label}" />
            <TextBox Style="{DynamicResource Input.Texto}"
                     Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Placa" Style="{DynamicResource Input.Label}" />
            <TextBox Style="{DynamicResource Input.Texto}"
                     Text="{Binding Placa, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="Matrícula (certificado)" Style="{DynamicResource Input.Label}" />
            <TextBox Style="{DynamicResource Input.Texto}"
                     Text="{Binding Matricula, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Número del certificado de matrícula emitido por la DGII" />
          </StackPanel>
        </Grid>

        <!-- VIN / Kilometraje -->
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="VIN / Chasis" Style="{DynamicResource Input.Label}" />
            <TextBox Style="{DynamicResource Input.Texto}"
                     Text="{Binding Vin, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Número de identificación del vehículo (hasta 17 caracteres)" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Kilometraje" Style="{DynamicResource Input.Label}" />
            <TextBox Style="{DynamicResource Input.Texto}"
                     Text="{Binding Kilometraje, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>

        <!-- Costo de adquisición / Gastos de importación -->
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Costo de adquisición (RD$)" Style="{DynamicResource Input.Label}" />
            <TextBox Style="{DynamicResource Input.Texto}"
                     Text="{Binding CostoAdquisicion, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Gastos de importación (RD$)" Style="{DynamicResource Input.Label}" />
            <TextBox Style="{DynamicResource Input.Texto}"
                     Text="{Binding GastosImportacion, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Aduana, flete, preparación" />
          </StackPanel>
        </Grid>

        <!-- Precio de venta -->
        <TextBlock Text="Precio de venta (RD$)" Style="{DynamicResource Input.Label}" Margin="0,14,0,6" />
        <TextBox Style="{DynamicResource Input.Texto}"
                 Text="{Binding PrecioVenta, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Vista previa costo total / ganancia -->
        <Border Background="{DynamicResource Brush.PrimarioSutil}" CornerRadius="10"
                Padding="16,12" Margin="0,16,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="COSTO TOTAL" Style="{DynamicResource Texto.MicroLabel}" />
              <TextBlock Text="{Binding CostoTotal, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Titulo3}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="GANANCIA ESTIMADA" Style="{DynamicResource Texto.MicroLabel}" />
              <TextBlock Text="{Binding GananciaEstimada, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Titulo3}" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Notas -->
        <TextBlock Text="Notas" Style="{DynamicResource Input.Label}" Margin="0,14,0,6" />
        <TextBox Style="{DynamicResource Input.Texto}" Height="72"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalContentAlignment="Top" Padding="10,8"
                 Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="{Binding MensajeError}"
                   Foreground="{DynamicResource Brush.Destructivo}"
                   Style="{DynamicResource Texto.Caption}"
                   TextWrapping="Wrap" Margin="0,12,0,0" />

        <!-- Botones: Cancelar / Guardar -->
        <Grid Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="Cancelar" Style="{DynamicResource Boton.Secundario}"
                  Command="{Binding CancelarCommand}" />
          <Button Grid.Column="2" Content="Guardar vehículo" Style="{DynamicResource Boton.Primario}"
                  Command="{Binding GuardarCommand}"
                  IsEnabled="{Binding Ocupado, Converter={StaticResource InversorBool}}" />
        </Grid>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
