<Window x:Class="FAControl.Views.RenovarAlquilerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renovar alquiler"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.FondoApp}">

  <Border Margin="24" Style="{DynamicResource Card}">
    <StackPanel>
      <TextBlock x:Name="TextoTitulo" Style="{DynamicResource Texto.Titulo3}" TextWrapping="Wrap" />
      <TextBlock x:Name="TextoSubtitulo" Style="{DynamicResource Texto.Caption}"
                 TextWrapping="Wrap" Margin="0,6,0,0" />

      <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nueva fecha de devolución"
                   Style="{DynamicResource Input.Label}" />
        <DatePicker Grid.Row="1" Grid.Column="0" x:Name="SelectorFin" Height="34"
                    SelectedDateChanged="Campo_Changed" />

        <TextBlock Grid.Row="0" Grid.Column="2" Text="Tarifa por día (DOP)"
                   Style="{DynamicResource Input.Label}" />
        <TextBox Grid.Row="1" Grid.Column="2" x:Name="CajaTarifa" Height="34"
                 Style="{DynamicResource Input.Texto}" TextChanged="Tarifa_Changed" />
      </Grid>

      <TextBlock x:Name="TextoTarifa" Style="{DynamicResource Texto.Caption}"
                 TextWrapping="Wrap" Margin="0,6,0,0" />

      <!-- Cómo queda el tramo nuevo con lo que se está tipeando -->
      <Border Margin="0,14,0,0" CornerRadius="8" Padding="14,12"
              Background="{DynamicResource Brush.PrimarioSutil}">
        <TextBlock x:Name="TextoCuenta" Style="{DynamicResource Texto.CuerpoEnfatizado}"
                   TextWrapping="Wrap" />
      </Border>

      <TextBlock Text="Notas (opcional)" Style="{DynamicResource Input.Label}" Margin="0,14,0,0" />
      <TextBox x:Name="CajaNotas" Height="52" Style="{DynamicResource Input.Texto}"
               TextWrapping="Wrap" AcceptsReturn="True"
               VerticalContentAlignment="Top" Padding="10,8" />

      <TextBlock x:Name="TextoError" Style="{DynamicResource Texto.Caption}"
                 Foreground="{DynamicResource Brush.Destructivo}"
                 TextWrapping="Wrap" Margin="0,10,0,0" />

      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="Renovar" Style="{DynamicResource Boton.Primario}"
                Click="Confirmar_Click" />
        <Button Grid.Column="2" Content="Volver" Style="{DynamicResource Boton.Secundario}"
                IsCancel="True" Click="Volver_Click" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
