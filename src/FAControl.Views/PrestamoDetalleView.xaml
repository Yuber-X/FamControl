<UserControl x:Class="FAControl.Views.PrestamoDetalleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:FAControl.Views"
             DataContextChanged="PrestamoDetalleView_DataContextChanged">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header en DOS filas (pedido de Yuber 2026-07-18): arriba volver +
         código/cliente/estado; los botones de acción DEBAJO. -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <DockPanel>
        <Button DockPanel.Dock="Left" Content="← Préstamos"
                Style="{DynamicResource Boton.Terciario}"
                VerticalAlignment="Center"
                Command="{Binding VolverCommand}" />
        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
          <Viewbox Style="{DynamicResource Metrica.Valor}">
            <TextBlock Text="{Binding Codigo}" Style="{DynamicResource Texto.Titulo2}"
                       FontFamily="{DynamicResource Fuente.Mono}" VerticalAlignment="Center" />
          </Viewbox>
          <Viewbox Style="{DynamicResource Metrica.Valor}">
            <TextBlock Text="{Binding ClienteNombre}" Style="{DynamicResource Texto.Titulo2}" VerticalAlignment="Center" />
          </Viewbox>
          <Border Style="{DynamicResource Pill.EstadoPrestamo}" VerticalAlignment="Center">
            <TextBlock Text="{Binding EstadoTexto}" Style="{DynamicResource Pill.EstadoPrestamo.Texto}" />
          </Border>
        </StackPanel>
      </DockPanel>

      <!-- Acciones, debajo -->
      <WrapPanel Orientation="Horizontal" Margin="0,14,0,0">
        <!-- Imprimir: disponible SIEMPRE, también en préstamos pagados o
             cancelados (el cliente puede necesitar el historial impreso) -->
        <Button Content="Imprimir" Style="{DynamicResource Boton.Secundario}"
                Command="{Binding ImprimirCommand}"
                Margin="0,0,8,8" />
        <!-- Contratos (2026-09-03): los tres documentos del prestamo, con vista
             previa e impresion. Lo que se imprime queda archivado en el
             expediente de este prestamo. -->
        <Button Content="Contratos" Style="{DynamicResource Boton.Secundario}"
                Command="{Binding VerContratosCommand}"
                ToolTip="Ver o imprimir el pagaré, el pagaré notarial o los dos juntos"
                Margin="0,0,8,8" />
        <!-- Intimación de pago: requerimiento formal para cuotas vencidas
             (ver docs/INTIMACION-Y-MANDAMIENTO.md) -->
        <Button Content="Intimación de pago" Style="{DynamicResource Boton.Secundario}"
                Command="{Binding ImprimirIntimacionCommand}"
                Margin="0,0,8,8" />
        <!-- Recordatorio individual al correo del cliente de este préstamo -->
        <Button Content="Enviar recordatorio" Style="{DynamicResource Boton.Secundario}"
                Command="{Binding EnviarRecordatorioCommand}"
                ToolTip="Envía un recordatorio de pago al correo de este cliente"
                Visibility="{Binding EsActivo, Converter={StaticResource BoolAVisibilidad}}"
                Margin="0,0,8,8" />
        <!-- Editar (029): corregir errores de digitación. Solo lo ve el Admin
             o quien tenga el permiso 'prestamos_editar' que él otorga. Qué
             tanto se puede corregir lo decide el servicio según si ya hubo
             cobros; el diálogo lo explica. -->
        <Button Content="Editar" Style="{DynamicResource Boton.Secundario}"
                Command="{Binding EditarCommand}"
                ToolTip="Corregir los datos de este préstamo"
                Visibility="{Binding PuedeEditar, Converter={StaticResource BoolAVisibilidad}}"
                Margin="0,0,8,8" />
        <Button Content="Cancelar préstamo" Style="{DynamicResource Boton.Destructivo}"
                Command="{Binding CancelarPrestamoCommand}"
                Visibility="{Binding EsActivo, Converter={StaticResource BoolAVisibilidad}}"
                Margin="0,0,8,8" />
        <Button Content="Registrar pago" Style="{DynamicResource Boton.Primario}"
                Command="{Binding CobrarCommand}"
                Visibility="{Binding EsActivo, Converter={StaticResource BoolAVisibilidad}}"
                Margin="0,0,0,8" />
      </WrapPanel>
    </StackPanel>

    <!-- Métricas -->
    <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,12">
      <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="CAPITAL PRESTADO" Style="{DynamicResource Texto.MicroLabel}" />
          <Viewbox Style="{DynamicResource Metrica.Valor}">
            <TextBlock Text="{Binding MontoCapital, Converter={StaticResource Money}}"
                       Style="{DynamicResource Texto.Titulo2}" />
          </Viewbox>
        </StackPanel>
      </Border>
      <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="TOTAL A PAGAR" Style="{DynamicResource Texto.MicroLabel}" />
          <Viewbox Style="{DynamicResource Metrica.Valor}">
            <TextBlock Text="{Binding TotalAPagar, Converter={StaticResource Money}}"
                       Style="{DynamicResource Texto.Titulo2}" />
          </Viewbox>
        </StackPanel>
      </Border>
      <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="COBRADO" Style="{DynamicResource Texto.MicroLabel}" />
          <Viewbox Style="{DynamicResource Metrica.Valor}">
            <TextBlock Text="{Binding TotalPagado, Converter={StaticResource Money}}"
                       Style="{DynamicResource Texto.Titulo2}" />
          </Viewbox>
        </StackPanel>
      </Border>
      <Border Style="{DynamicResource Card.Metrica}">
        <StackPanel>
          <TextBlock Text="SALDO PENDIENTE" Style="{DynamicResource Texto.MicroLabel}" />
          <Viewbox Style="{DynamicResource Metrica.Valor}">
            <TextBlock Text="{Binding SaldoPendiente, Converter={StaticResource Money}}"
                       Style="{DynamicResource Texto.Titulo2}" />
          </Viewbox>
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Datos del contrato.
         Dos columnas (pedido de Yuber 2026-07-30, con captura): a la izquierda
         los datos y la NOTA, que necesita ancho para no volverse una columna
         angosta y larguísima; a la derecha, fijo, el comprobante fiscal. Antes
         el NCF iba dentro del mismo WrapPanel y le comía el espacio a la nota. -->
    <Border Grid.Row="2" Style="{DynamicResource Card}" Margin="0,0,0,12" Padding="20,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <WrapPanel>
            <StackPanel Margin="0,0,32,0">
              <TextBlock Text="TASA" Style="{DynamicResource Texto.MicroLabel}" />
              <TextBlock Text="{Binding TasaTexto}" Style="{DynamicResource Texto.CuerpoEnfatizado}" />
            </StackPanel>
            <StackPanel Margin="0,0,32,0">
              <TextBlock Text="MODALIDAD" Style="{DynamicResource Texto.MicroLabel}" />
              <TextBlock Text="{Binding ModalidadTexto}" Style="{DynamicResource Texto.CuerpoEnfatizado}" />
            </StackPanel>
            <StackPanel Margin="0,0,32,0">
              <TextBlock Text="MÉTODO" Style="{DynamicResource Texto.MicroLabel}" />
              <TextBlock Text="{Binding MetodoTexto}" Style="{DynamicResource Texto.CuerpoEnfatizado}" />
            </StackPanel>
            <StackPanel Margin="0,0,32,0">
              <TextBlock Text="PRIMER PAGO" Style="{DynamicResource Texto.MicroLabel}" />
              <TextBlock Text="{Binding FechaInicioTexto}" Style="{DynamicResource Texto.CuerpoEnfatizado}" />
            </StackPanel>
            <StackPanel Margin="0,0,32,0">
              <TextBlock Text="PROGRESO" Style="{DynamicResource Texto.MicroLabel}" />
              <TextBlock Text="{Binding ProgresoTexto}" Style="{DynamicResource Texto.CuerpoEnfatizado}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="GARANTÍA" Style="{DynamicResource Texto.MicroLabel}" />
              <TextBlock Text="{Binding GarantiaTexto}" Style="{DynamicResource Texto.CuerpoEnfatizado}" />
            </StackPanel>
          </WrapPanel>

          <!-- ===== Pagaré notarial (044) =====
               Solo aparece si se cargó algo del acta: un préstamo que no va a
               pasar por notario no tiene por qué mostrar una sección vacía. -->
          <Border Style="{DynamicResource Card}" Margin="0,14,24,0" Padding="14,12"
                  Visibility="{Binding TieneDatosNotariales, Converter={StaticResource BoolAVisibilidad}}">
            <StackPanel>
              <TextBlock Text="PAGARÉ NOTARIAL" Style="{DynamicResource Texto.MicroLabel}"
                         Margin="0,0,0,8" />
              <WrapPanel>
                <StackPanel Margin="0,0,32,8"
                            Visibility="{Binding ActoTexto, Converter={StaticResource TextoAVisibilidad}}">
                  <TextBlock Text="ACTO" Style="{DynamicResource Texto.MicroLabel}" />
                  <TextBlock Text="{Binding ActoTexto}" Style="{DynamicResource Texto.CuerpoEnfatizado}" />
                </StackPanel>
                <StackPanel Margin="0,0,32,8"
                            Visibility="{Binding MunicipioActoTexto, Converter={StaticResource TextoAVisibilidad}}">
                  <TextBlock Text="MUNICIPIO" Style="{DynamicResource Texto.MicroLabel}" />
                  <TextBlock Text="{Binding MunicipioActoTexto}" Style="{DynamicResource Texto.CuerpoEnfatizado}" />
                </StackPanel>
                <StackPanel Margin="0,0,32,8"
                            Visibility="{Binding DeudorActaTexto, Converter={StaticResource TextoAVisibilidad}}">
                  <TextBlock Text="EL DEUDOR EN EL ACTA" Style="{DynamicResource Texto.MicroLabel}" />
                  <TextBlock Text="{Binding DeudorActaTexto}" Style="{DynamicResource Texto.CuerpoEnfatizado}" />
                </StackPanel>
                <StackPanel Margin="0,0,32,8"
                            Visibility="{Binding CondicionesActaTexto, Converter={StaticResource TextoAVisibilidad}}">
                  <TextBlock Text="CONDICIONES" Style="{DynamicResource Texto.MicroLabel}" />
                  <TextBlock Text="{Binding CondicionesActaTexto}" Style="{DynamicResource Texto.CuerpoEnfatizado}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,8"
                            Visibility="{Binding RegistroTitulosTexto, Converter={StaticResource TextoAVisibilidad}}">
                  <TextBlock Text="REGISTRO DE TÍTULOS" Style="{DynamicResource Texto.MicroLabel}" />
                  <TextBlock Text="{Binding RegistroTitulosTexto}" Style="{DynamicResource Texto.CuerpoEnfatizado}" />
                </StackPanel>
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- La nota usa todo el ancho de la columna: así ocupa pocas líneas
               en vez de una tira angosta -->
          <StackPanel Margin="0,12,24,0"
                      Visibility="{Binding TieneNotas, Converter={StaticResource BoolAVisibilidad}}">
            <TextBlock Text="NOTAS" Style="{DynamicResource Texto.MicroLabel}" />
            <TextBlock Text="{Binding NotasTexto}" Style="{DynamicResource Texto.Cuerpo}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>

        <!-- Comprobante fiscal (2026-07-25), a la derecha desde el 2026-07-30 -->
        <StackPanel Grid.Column="1" MinWidth="240" VerticalAlignment="Top">
          <TextBlock Text="COMPROBANTE FISCAL (NCF)" Style="{DynamicResource Texto.MicroLabel}" />
          <TextBlock Text="{Binding NcfTexto}" Style="{DynamicResource Texto.CuerpoEnfatizado}"
                     Visibility="{Binding TieneNcf, Converter={StaticResource BoolAVisibilidad}}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding TieneNcf}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBox Width="160" Height="30" Style="{DynamicResource Input.Texto}"
                     ToolTip="Pega el e-NCF del Facturador Gratuito DGII, o dejalo vacío para tomar el siguiente de la secuencia"
                     v:Marcador.Texto="{Binding NcfMarcador}"
                     Text="{Binding NcfManual, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Asignar" Style="{DynamicResource Boton.Terciario}" Margin="6,0,0,0"
                    Command="{Binding AsignarNcfCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Tabla de cuotas -->
    <Border Grid.Row="3" Style="{DynamicResource Card}" Padding="0">
      <DataGrid Style="{DynamicResource Tabla}" ItemsSource="{Binding Cuotas}">
        <DataGrid.RowStyle>
          <!-- Cuotas vencidas: indicador rojo lateral izquierdo (DESIGN.md §9) -->
          <Style TargetType="DataGridRow" BasedOn="{StaticResource Tabla.Fila}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding EstaVencida}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Destructivo}" />
                <Setter Property="BorderThickness" Value="3,0,0,0.5" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
          <DataGridTextColumn Header="N°" Binding="{Binding Numero}" Width="50" />
          <DataGridTextColumn Header="Vencimiento" Binding="{Binding FechaTexto}" Width="110" />
          <DataGridTextColumn Header="Capital"
                              Binding="{Binding Capital, Converter={StaticResource Money}}" Width="120">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Interés"
                              Binding="{Binding Interes, Converter={StaticResource Money}}" Width="120">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Cuota"
                              Binding="{Binding MontoTotal, Converter={StaticResource Money}}" Width="120">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.MontoTotal}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Abonado"
                              Binding="{Binding MontoPagado, Converter={StaticResource Money}}" Width="120">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Saldo restante"
                              Binding="{Binding SaldoDespues, Converter={StaticResource Money}}" Width="130">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTemplateColumn Header="Estado" Width="*" MinWidth="120"
                                  HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{DynamicResource Pill.Semaforo}">
                  <TextBlock Text="{Binding SemaforoTexto}"
                             Style="{DynamicResource Pill.Semaforo.Texto}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</UserControl>
