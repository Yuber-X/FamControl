<UserControl x:Class="FAControl.Views.ReportesDealView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Filtros de rango -->
    <Border Grid.Row="0" Style="{DynamicResource Card}" Margin="0,0,0,12" Padding="20,14">
      <WrapPanel>
        <StackPanel Margin="0,0,12,6">
          <TextBlock Text="Desde" Style="{DynamicResource Input.Label}" />
          <DatePicker Width="150" Height="36" SelectedDate="{Binding Desde}" />
        </StackPanel>
        <StackPanel Margin="0,0,16,6">
          <TextBlock Text="Hasta" Style="{DynamicResource Input.Label}" />
          <DatePicker Width="150" Height="36" SelectedDate="{Binding Hasta}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
          <Button Content="Generar" Style="{DynamicResource Boton.Primario}"
                  Command="{Binding GenerarCommand}" />
          <Button Content="Este mes" Style="{DynamicResource Boton.Terciario}" Margin="8,0,0,0"
                  Command="{Binding EsteMesCommand}" />
          <Button Content="Mes pasado" Style="{DynamicResource Boton.Terciario}" Margin="4,0,0,0"
                  Command="{Binding MesPasadoCommand}" />
          <Button Content="Trimestre" Style="{DynamicResource Boton.Terciario}" Margin="4,0,0,0"
                  Command="{Binding TrimestreCommand}" />
          <Button Content="Año" Style="{DynamicResource Boton.Terciario}" Margin="4,0,0,0"
                  Command="{Binding AnioCommand}" />
        </StackPanel>
      </WrapPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Visibility="{Binding TieneReporte, Converter={StaticResource BoolAVisibilidad}}">

        <!-- KPIs de ventas del período -->
        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,12">
          <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0"
                  Background="{DynamicResource Brush.Primario}">
            <StackPanel>
              <TextBlock Text="GANANCIA DEL PERÍODO" Style="{DynamicResource Texto.MicroLabel}" Foreground="#C7CBFB" />
              <Viewbox Style="{DynamicResource Metrica.Valor}">
                <TextBlock Text="{Binding GananciaVentas, Converter={StaticResource Money}}"
                           Style="{DynamicResource Texto.Display}" Foreground="White" />
              </Viewbox>
              <TextBlock Text="{Binding RangoTexto}" Style="{DynamicResource Texto.Caption}" Foreground="#C7CBFB" />
            </StackPanel>
          </Border>
          <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
            <StackPanel>
              <TextBlock Text="MONTO VENDIDO" Style="{DynamicResource Texto.MicroLabel}" />
              <Viewbox Style="{DynamicResource Metrica.Valor}">
                <TextBlock Text="{Binding MontoVendido, Converter={StaticResource Money}}"
                           Style="{DynamicResource Texto.Display}" />
              </Viewbox>
              <TextBlock Style="{DynamicResource Texto.Caption}">
                <Run Text="{Binding CantidadVentas, Mode=OneWay}" /><Run Text=" venta(s) en el período" />
              </TextBlock>
            </StackPanel>
          </Border>
          <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
            <StackPanel>
              <TextBlock Text="INGRESOS POR ALQUILER" Style="{DynamicResource Texto.MicroLabel}" />
              <Viewbox Style="{DynamicResource Metrica.Valor}">
                <TextBlock Text="{Binding IngresosAlquiler, Converter={StaticResource Money}}"
                           Style="{DynamicResource Texto.Display}" />
              </Viewbox>
              <TextBlock Style="{DynamicResource Texto.Caption}">
                <Run Text="{Binding CantidadAlquileres, Mode=OneWay}" /><Run Text=" alquiler(es) en el período" />
              </TextBlock>
            </StackPanel>
          </Border>
          <Border Style="{DynamicResource Card.Metrica}">
            <StackPanel>
              <TextBlock Text="PENDIENTE DE COBRO" Style="{DynamicResource Texto.MicroLabel}" />
              <Viewbox Style="{DynamicResource Metrica.Valor}">
                <TextBlock Text="{Binding PendienteDeCobro, Converter={StaticResource Money}}"
                           Style="{DynamicResource Texto.Display}" />
              </Viewbox>
              <TextBlock Text="Plazos vivos de ventas financiadas" Style="{DynamicResource Texto.Caption}" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <!-- Inventario (foto de hoy) -->
        <UniformGrid Rows="1" Columns="2" Margin="0,0,0,12">
          <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
            <StackPanel>
              <TextBlock Text="VEHÍCULOS DISPONIBLES" Style="{DynamicResource Texto.MicroLabel}" />
              <Viewbox Style="{DynamicResource Metrica.Valor}">
                <TextBlock Text="{Binding VehiculosDisponibles}" Style="{DynamicResource Texto.Display}" />
              </Viewbox>
              <TextBlock Text="En inventario ahora mismo" Style="{DynamicResource Texto.Caption}" />
            </StackPanel>
          </Border>
          <Border Style="{DynamicResource Card.Metrica}">
            <StackPanel>
              <TextBlock Text="INVERSIÓN EN INVENTARIO" Style="{DynamicResource Texto.MicroLabel}" />
              <Viewbox Style="{DynamicResource Metrica.Valor}">
                <TextBlock Text="{Binding CapitalInvertido, Converter={StaticResource Money}}"
                           Style="{DynamicResource Texto.Display}" />
              </Viewbox>
              <TextBlock Text="Costo + importación de lo no vendido" Style="{DynamicResource Texto.Caption}" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <!-- Comisiones por vendedor -->
        <Border Style="{DynamicResource Card}" Padding="20,14">
          <StackPanel>
            <TextBlock Text="Ventas y comisiones por vendedor" Style="{DynamicResource Texto.Titulo3}" />
            <TextBlock Text="{Binding ComisionTexto}" Style="{DynamicResource Texto.Caption}"
                       TextWrapping="Wrap" Margin="0,4,0,10" />
            <DataGrid Style="{DynamicResource Tabla}" ItemsSource="{Binding PorVendedor}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      MaxHeight="300"
                      Visibility="{Binding HayComisiones, Converter={StaticResource BoolAVisibilidad}}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Vendedor" Binding="{Binding VendedorNombre}" Width="*" MinWidth="180"
                                    HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
                <DataGridTextColumn Header="Ventas" Binding="{Binding CantidadVentas}" Width="90" />
                <DataGridTextColumn Header="Monto vendido" Width="180"
                                    Binding="{Binding MontoVendido, Converter={StaticResource Money}}">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Comisión" Width="180"
                                    Binding="{Binding Comisiones, Converter={StaticResource Money}}">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
