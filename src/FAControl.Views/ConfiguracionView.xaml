<UserControl x:Class="FAControl.Views.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
    <StackPanel MaxWidth="720" HorizontalAlignment="Left">

      <!-- ============ APARIENCIA ============ -->
      <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Apariencia" Style="{DynamicResource Texto.Titulo3}" Margin="0,0,0,4" />
          <TextBlock Text="Tamaño del texto en toda la aplicación."
                     Style="{DynamicResource Texto.Caption}" Margin="0,0,0,12" />
          <StackPanel Orientation="Horizontal" Loaded="RadiosTamano_Loaded">
            <RadioButton x:Name="RadioPequeno" Content="Pequeño" GroupName="Tamano"
                         Margin="0,0,20,0" FontSize="13" Checked="TamanoPequeno_Checked" />
            <RadioButton x:Name="RadioMediano" Content="Mediano" GroupName="Tamano"
                         Margin="0,0,20,0" FontSize="13" Checked="TamanoMediano_Checked" />
            <RadioButton x:Name="RadioGrande" Content="Grande" GroupName="Tamano"
                         FontSize="13" Checked="TamanoGrande_Checked" />
          </StackPanel>

          <!-- Modo noche (pedido del cliente 2026-07-16). Binding directo:
               el VM aplica el tema y lo recuerda por PC. -->
          <Border Height="1" Background="{DynamicResource Brush.BordeSutil}" Margin="0,16,0,14" />
          <CheckBox Content="Modo oscuro" FontSize="13" IsChecked="{Binding TemaOscuro}" />
          <TextBlock Text="Invierte los colores para trabajar de noche o con poca luz. Se aplica al instante y se recuerda en esta computadora."
                     Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />

          <!-- Arranque directo (cliente 2026-07-29): se prende en la pantalla de
               inicio y se apaga acá. -->
          <Border Height="1" Background="{DynamicResource Brush.BordeSutil}" Margin="0,16,0,14" />
          <CheckBox Content="Abrir directamente esta estancia al iniciar FAControl"
                    FontSize="13" IsChecked="{Binding ArranqueDirectoActivo}" />
          <TextBlock Text="{Binding ArranqueDirectoTexto}"
                     Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <!-- ============ IMPRESIÓN DEL TICKET (POS-500, 2026-07-30) ============ -->
      <Border Style="{DynamicResource Card}" Margin="0,0,0,12"
              Visibility="{Binding EsPos500, Converter={StaticResource BoolAVisibilidad}}">
        <StackPanel>
          <TextBlock Text="Impresión del ticket" Style="{DynamicResource Texto.Titulo3}" Margin="0,0,0,4" />
          <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                     Text="Preferencias de ESTA computadora: cada terminal puede tener su propia impresora." />

          <TextBlock Text="Impresora del ticket" Style="{DynamicResource Input.Label}" />
          <ComboBox Width="360" Height="38" FontSize="13" HorizontalAlignment="Left"
                    ItemsSource="{Binding Impresoras}"
                    SelectedItem="{Binding ImpresoraSeleccionada}" />
          <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                     Text="Si dejás la predeterminada de Windows y esa es &quot;Microsoft Print to PDF&quot;, al cobrar te va a pedir guardar un archivo en vez de imprimir. Elegí acá la impresora del mostrador." />

          <CheckBox Content="Ver el ticket antes de imprimir" FontSize="13" Margin="0,14,0,0"
                    IsChecked="{Binding MostrarVistaPreviaTicket}" />
          <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                     Text="Apagado, el ticket sale directo al cobrar — con un cliente esperando es lo que conviene. Al reimprimir desde Comprobantes siempre se muestra primero, esté como esté esta casilla." />

          <TextBlock Text="Copias del ticket (1 a 3)" Style="{DynamicResource Input.Label}" Margin="0,14,0,0" />
          <TextBox Width="80" Height="34" HorizontalAlignment="Left"
                   Style="{DynamicResource Input.Texto}"
                   Text="{Binding CopiasTicketTexto, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="Encabezado del ticket (opcional)" Style="{DynamicResource Input.Label}" Margin="0,14,0,0" />
          <TextBox Width="360" Height="52" HorizontalAlignment="Left"
                   Style="{DynamicResource Input.Texto}" TextWrapping="Wrap" AcceptsReturn="True"
                   VerticalContentAlignment="Top" Padding="10,8"
                   Text="{Binding TicketEncabezado, UpdateSourceTrigger=LostFocus}" />

          <TextBlock Text="Pie del ticket (opcional)" Style="{DynamicResource Input.Label}" Margin="0,14,0,0" />
          <TextBox Width="360" Height="52" HorizontalAlignment="Left"
                   Style="{DynamicResource Input.Texto}" TextWrapping="Wrap" AcceptsReturn="True"
                   VerticalContentAlignment="Top" Padding="10,8"
                   Text="{Binding TicketPie, UpdateSourceTrigger=LostFocus}" />
        </StackPanel>
      </Border>

      <!-- ============ DATOS DEL NEGOCIO (cliente 2026-07-25) ============ -->
      <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Datos del negocio" Style="{DynamicResource Texto.Titulo3}" Margin="0,0,0,4" />
          <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                     Text="Aparecen en el pagaré, los recibos/facturas y la intimación de pago. El RNC y el teléfono salen en el encabezado de la factura." />
          <WrapPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock Text="Nombre de la empresa" Style="{DynamicResource Input.Label}" />
              <TextBox Width="280" Style="{DynamicResource Input.Texto}" Height="34"
                       Text="{Binding NegocioNombre, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock Text="RNC" Style="{DynamicResource Input.Label}" />
              <TextBox Width="160" Style="{DynamicResource Input.Texto}" Height="34"
                       Text="{Binding NegocioRnc, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock Text="Teléfono" Style="{DynamicResource Input.Label}" />
              <TextBox Width="160" Style="{DynamicResource Input.Texto}" Height="34"
                       Text="{Binding NegocioTelefono, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </WrapPanel>
          <WrapPanel Margin="0,4,0,0">
            <!-- El prestamista firma el pagaré: en el punto de venta no hay
                 préstamos, así que ese dato no va (pedido de Yuber 2026-07-31) -->
            <StackPanel Margin="0,0,16,8"
                        Visibility="{Binding EsPos500, Converter={StaticResource InversorBoolVisibilidad}}">
              <TextBlock Text="Dueño / prestamista (firma el pagaré)" Style="{DynamicResource Input.Label}" />
              <TextBox Width="280" Style="{DynamicResource Input.Texto}" Height="34"
                       Text="{Binding NegocioPrestamista, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock Text="Ciudad" Style="{DynamicResource Input.Label}" />
              <TextBox Width="160" Style="{DynamicResource Input.Texto}" Height="34"
                       Text="{Binding NegocioCiudad, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock Text="Correo" Style="{DynamicResource Input.Label}" />
              <TextBox Width="200" Style="{DynamicResource Input.Texto}" Height="34"
                       Text="{Binding NegocioEmail, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <!-- La comision solo la usa el reporte de DealControl: en las
                 demas estancias no la lee nadie (Yuber 2026-07-31) -->
            <StackPanel Margin="0,0,16,8"
                        Visibility="{Binding MuestraComisionVendedor, Converter={StaticResource BoolAVisibilidad}}">
              <TextBlock Text="Comisión del vendedor (%)" Style="{DynamicResource Input.Label}" />
              <TextBox Width="140" Style="{DynamicResource Input.Texto}" Height="34"
                       ToolTip="DealControl: % sobre el monto vendido que se muestra en el reporte de comisiones"
                       Text="{Binding ComisionVendedorTexto, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- ============ ITBIS (POS-500, pedido de Yuber 2026-07-31) ============ -->
      <Border Style="{DynamicResource Card}" Margin="0,0,0,12"
              Visibility="{Binding PuedeConfigurarItbis, Converter={StaticResource BoolAVisibilidad}}">
        <StackPanel>
          <TextBlock Text="ITBIS" Style="{DynamicResource Texto.Titulo3}" Margin="0,0,0,4" />
          <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                     Text="Impuesto que se cobra en cada venta del punto de venta. Es del NEGOCIO, no de esta computadora: al cambiarlo cambia en todas las terminales. No toca las facturas ya emitidas." />
          <CheckBox Content="Cobrar ITBIS en las ventas" FontSize="13"
                    IsChecked="{Binding ItbisActivo}" />
          <StackPanel Orientation="Horizontal" Margin="24,10,0,0"
                      IsEnabled="{Binding ItbisActivo}">
            <StackPanel>
              <TextBlock Text="Tasa (%)" Style="{DynamicResource Input.Label}" />
              <TextBox Width="90" Height="34" Style="{DynamicResource Input.Texto}"
                       Text="{Binding ItbisTasaTexto, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="En República Dominicana el ITBIS general es 18%" />
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Guardar ITBIS" Style="{DynamicResource Boton.Primario}"
                    Command="{Binding GuardarItbisCommand}" />
            <TextBlock Text="{Binding ItbisEstadoTexto}" Style="{DynamicResource Texto.Caption}"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       TextWrapping="Wrap" MaxWidth="420" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============ COMPROBANTE FISCAL / SECUENCIA NCF (cliente 2026-07-25) ============ -->
      <Border Style="{DynamicResource Card}" Margin="0,0,0,12"
              Visibility="{Binding PuedeConfigurarNcf, Converter={StaticResource BoolAVisibilidad}}">
        <StackPanel>
          <TextBlock Text="Comprobante fiscal (NCF)" Style="{DynamicResource Texto.Titulo3}" Margin="0,0,0,4" />
          <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                     Text="Secuencia autorizada por la DGII para numerar comprobantes desde la app (prefijo B02 tradicional o E32 e-CF). Si usan el Facturador Gratuito de la DGII, no hace falta configurarla: el e-NCF generado allá se pega en el préstamo." />
          <CheckBox Content="Usar secuencia local de comprobantes" FontSize="13"
                    IsChecked="{Binding NcfActivo}" />
          <StackPanel Margin="24,10,0,0" IsEnabled="{Binding NcfActivo}">
            <WrapPanel>
              <StackPanel Margin="0,0,16,8">
                <TextBlock Text="Prefijo (serie + tipo)" Style="{DynamicResource Input.Label}" />
                <TextBox Width="90" Style="{DynamicResource Input.Texto}" Height="34"
                         Text="{Binding NcfPrefijo, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Margin="0,0,16,8">
                <TextBlock Text="Dígitos (8 ó 10)" Style="{DynamicResource Input.Label}" />
                <TextBox Width="70" Style="{DynamicResource Input.Texto}" Height="34"
                         Text="{Binding NcfLargoTexto, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Margin="0,0,16,8">
                <TextBlock Text="Próxima secuencia" Style="{DynamicResource Input.Label}" />
                <TextBox Width="120" Style="{DynamicResource Input.Texto}" Height="34"
                         Text="{Binding NcfProximaTexto, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Margin="0,0,16,8">
                <TextBlock Text="Fin del rango (opcional)" Style="{DynamicResource Input.Label}" />
                <TextBox Width="120" Style="{DynamicResource Input.Texto}" Height="34"
                         Text="{Binding NcfFinTexto, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Margin="0,0,16,8">
                <TextBlock Text="Vence (opcional)" Style="{DynamicResource Input.Label}" />
                <DatePicker Width="140" Height="34"
                            SelectedDate="{Binding NcfVencimiento}" />
              </StackPanel>
            </WrapPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Guardar secuencia" Style="{DynamicResource Boton.Primario}"
                    Command="{Binding GuardarNcfCommand}" />
            <TextBlock Text="{Binding NcfEstadoTexto}" Style="{DynamicResource Texto.Caption}"
                       VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="380" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============ AVISO DE VENCIMIENTOS ============ -->
      <!-- Es de préstamos: el punto de venta no cobra cuotas (Yuber 2026-07-31) -->
      <Border Style="{DynamicResource Card}" Margin="0,0,0,12"
              Visibility="{Binding EsPos500, Converter={StaticResource InversorBoolVisibilidad}}">
        <StackPanel>
          <TextBlock Text="Aviso de pagos vencidos" Style="{DynamicResource Texto.Titulo3}" Margin="0,0,0,4" />
          <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                     Text="Al iniciar (y al cambiar el día con la aplicación abierta) se muestra la lista de clientes que se pasaron de su fecha de pago." />
          <CheckBox Content="Avisar cuando un cliente se pase de su fecha de pago" FontSize="13"
                    IsChecked="{Binding AvisoVencidosActivo}" />
          <StackPanel Orientation="Horizontal" Margin="24,10,0,0">
            <TextBlock Text="{Binding SilenciadosTexto}" Style="{DynamicResource Texto.Caption}"
                       VerticalAlignment="Center" />
            <Button Content="Restablecer silenciados" Style="{DynamicResource Boton.Terciario}"
                    Margin="8,0,0,0" Command="{Binding RestablecerSilenciadosCommand}"
                    Visibility="{Binding HaySilenciados, Converter={StaticResource BoolAVisibilidad}}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============ SEGURIDAD ============ -->
      <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Cambiar contraseña" Style="{DynamicResource Texto.Titulo3}" Margin="0,0,0,12" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Contraseña actual" Style="{DynamicResource Input.Label}" />
              <PasswordBox x:Name="CajaActual" Style="{DynamicResource Input.Password}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Nueva contraseña" Style="{DynamicResource Input.Label}" />
              <PasswordBox x:Name="CajaNueva" Style="{DynamicResource Input.Password}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="Confirmar nueva" Style="{DynamicResource Input.Label}" />
              <PasswordBox x:Name="CajaConfirmacion" Style="{DynamicResource Input.Password}" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding MensajePassword}"
                     Foreground="{DynamicResource Brush.Destructivo}"
                     Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
          <Button Content="Cambiar contraseña" Style="{DynamicResource Boton.Primario}"
                  HorizontalAlignment="Left" Margin="0,12,0,0"
                  Click="BotonCambiarPassword_Click" />
        </StackPanel>
      </Border>

      <!-- ============ RECORDATORIOS POR CORREO ============ -->
      <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="{Binding RecordatoriosTitulo}" Style="{DynamicResource Texto.Titulo3}"
                     Margin="0,0,0,4" />
          <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,0,0,4"
                     Text="{Binding RecordatoriosDescripcion}" />
          <!-- Guía del App Password: la causa #1 de fallos es usar la contraseña normal -->
          <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,0,0,12">
            <Run Text="La 'Contraseña de aplicación' NO es tu contraseña de Gmail, ni tu PIN, ni la de FAControl: es un código de 16 letras que genera Google (la cuenta remitente debe tener la verificación en 2 pasos activada). Pasos: 1) abrí " />
            <Hyperlink NavigateUri="https://myaccount.google.com/apppasswords"
                       RequestNavigate="Hyperlink_RequestNavigate">myaccount.google.com/apppasswords</Hyperlink>
            <Run Text="; 2) escribí un nombre (ej: FAControl) y tocá 'Crear'; 3) copiá las 16 letras que aparecen y pegalas acá (los espacios se quitan solos)." />
          </TextBlock>

          <CheckBox Content="{Binding RecordatoriosActivarTexto}" FontSize="13"
                    IsChecked="{Binding RecordatoriosActivos}" />

          <StackPanel Margin="24,10,0,0" IsEnabled="{Binding RecordatoriosActivos}">
            <WrapPanel>
              <StackPanel Margin="0,0,16,8">
                <TextBlock Text="Cuenta Gmail (remitente)" Style="{DynamicResource Input.Label}" />
                <TextBox Width="240" Style="{DynamicResource Input.Texto}" Height="34"
                         Text="{Binding GmailRemitente, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Margin="0,0,16,8">
                <TextBlock Text="Contraseña de aplicación" Style="{DynamicResource Input.Label}" />
                <PasswordBox x:Name="CampoGmailPassword" Width="200" Height="34"
                             Style="{DynamicResource Input.Password}"
                             PasswordChanged="CampoGmailPassword_PasswordChanged" />
                <TextBlock Text="✓ Contraseña guardada — dejá el campo vacío para conservarla."
                           Style="{DynamicResource Texto.Caption}" Margin="0,4,0,0"
                           Foreground="{DynamicResource Brush.DeltaPositivo}"
                           Visibility="{Binding HayAppPasswordGuardada, Converter={StaticResource BoolAVisibilidad}}" />
              </StackPanel>
            </WrapPanel>
            <WrapPanel Margin="0,4,0,0">
              <StackPanel Margin="0,0,16,8">
                <TextBlock Text="{Binding CorreoDuenoEtiqueta}" Style="{DynamicResource Input.Label}" />
                <TextBox Width="240" Style="{DynamicResource Input.Texto}" Height="34"
                         Text="{Binding CorreoDueno, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Margin="0,0,16,8">
                <TextBlock Text="{Binding RecordatoriosDiasEtiqueta}" Style="{DynamicResource Input.Label}" />
                <TextBox Width="70" Style="{DynamicResource Input.Texto}" Height="34"
                         Text="{Binding RecordatorioDiasTexto, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </WrapPanel>

            <CheckBox Content="Enviar automáticamente al abrir la aplicación (una vez al día)"
                      FontSize="13" Margin="0,6,0,0"
                      IsChecked="{Binding RecordatoriosAutomaticos}" />

            <WrapPanel Margin="0,12,0,0">
              <Button Content="Enviar prueba" Style="{DynamicResource Boton.Secundario}"
                      Command="{Binding EnviarPruebaCorreoCommand}" Margin="0,0,8,6"
                      IsEnabled="{Binding Ocupado, Converter={StaticResource InversorBool}}" />
              <Button Content="{Binding RecordatoriosBotonTexto}" Style="{DynamicResource Boton.Primario}"
                      Command="{Binding EnviarRecordatoriosCommand}" Margin="0,0,8,6"
                      IsEnabled="{Binding Ocupado, Converter={StaticResource InversorBool}}" />
            </WrapPanel>
            <TextBlock Text="{Binding UltimoRecordatorioTexto}" Style="{DynamicResource Texto.Caption}"
                       Margin="0,4,0,0" />
            <TextBlock Text="{Binding MensajeCorreo}" Style="{DynamicResource Texto.Caption}"
                       TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource Brush.Primario}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============ RESPALDO ============ -->
      <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Respaldo de la base de datos" Style="{DynamicResource Texto.Titulo3}"
                     Margin="0,0,0,4" />
          <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                     Text="El respaldo (.sql) guarda TODO tal cual está. Es la forma recomendada de migrar FAControl a otra computadora: respaldá aquí y restaurá allá." />
          <StackPanel Orientation="Horizontal">
            <Button Content="Respaldar ahora" Style="{DynamicResource Boton.Primario}"
                    Click="BotonRespaldar_Click" Margin="0,0,8,0"
                    IsEnabled="{Binding Ocupado, Converter={StaticResource InversorBool}}" />
            <Button Content="Restaurar desde archivo…" Style="{DynamicResource Boton.Destructivo}"
                    Click="BotonRestaurar_Click"
                    IsEnabled="{Binding Ocupado, Converter={StaticResource InversorBool}}" />
          </StackPanel>

          <Separator Margin="0,16" Background="{DynamicResource Brush.BordeSutil}" />

          <!-- Respaldo automático (cliente 2026-07-19) -->
          <CheckBox Content="Respaldar automáticamente al abrir la aplicación" FontSize="13"
                    IsChecked="{Binding RespaldoAutoActivo}" />
          <WrapPanel Margin="24,10,0,0" IsEnabled="{Binding RespaldoAutoActivo}">
            <TextBlock Text="Cada" Style="{DynamicResource Texto.Cuerpo}"
                       VerticalAlignment="Center" Margin="0,0,8,6" />
            <TextBox Width="56" Style="{DynamicResource Input.Texto}" Height="32" Margin="0,0,8,6"
                     Text="{Binding RespaldoCadaTexto, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="100" Height="32" FontSize="13" Margin="0,0,8,6"
                      ItemsSource="{Binding Unidades}" DisplayMemberPath="Texto"
                      SelectedItem="{Binding RespaldoUnidad}" />
            <TextBlock Text="en la carpeta:" Style="{DynamicResource Texto.Cuerpo}"
                       VerticalAlignment="Center" Margin="0,0,8,6" />
            <TextBox Width="240" Style="{DynamicResource Input.Texto}" Height="32" IsReadOnly="True"
                     Margin="0,0,4,6" Text="{Binding RespaldoCarpeta}" />
            <Button Content="Elegir…" Style="{DynamicResource Boton.Terciario}" Margin="0,0,0,6"
                    Click="BotonElegirCarpetaRespaldo_Click" />
          </WrapPanel>
          <TextBlock Text="{Binding UltimoRespaldoTexto}" Style="{DynamicResource Texto.Caption}"
                     Margin="24,4,0,0" />
          <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="24,6,0,0"
                     Foreground="{DynamicResource Brush.TextoTerciario}"
                     Text="Consejo: si elegís la carpeta de OneDrive o Google Drive de tu PC, cada respaldo se sube solo a la nube." />
        </StackPanel>
      </Border>

      <!-- ============ EXPORTACIÓN A EXCEL ============ -->
      <Border Style="{DynamicResource Card}">
        <StackPanel>
          <TextBlock Text="Exportación a Excel" Style="{DynamicResource Texto.Titulo3}" Margin="0,0,0,4" />
          <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                     Text="Genera un libro .xlsx con todos los datos (clientes, préstamos, cuotas, pagos e historial) para consultarlos fuera del sistema." />

          <Button Content="Exportar ahora…" Style="{DynamicResource Boton.Secundario}"
                  HorizontalAlignment="Left" Click="BotonExportar_Click"
                  IsEnabled="{Binding Ocupado, Converter={StaticResource InversorBool}}" />

          <Separator Margin="0,16" Background="{DynamicResource Brush.BordeSutil}" />

          <CheckBox Content="Exportar automáticamente al abrir la aplicación" FontSize="13"
                    IsChecked="{Binding ExportActivo}" />
          <StackPanel Orientation="Horizontal" Margin="24,10,0,0"
                      IsEnabled="{Binding ExportActivo}">
            <TextBlock Text="Cada" Style="{DynamicResource Texto.Cuerpo}" VerticalAlignment="Center" />
            <TextBox Width="60" Style="{DynamicResource Input.Texto}" Height="32" Margin="8,0"
                     Text="{Binding ExportCadaDiasTexto, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="días, en la carpeta:" Style="{DynamicResource Texto.Cuerpo}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Width="260" Style="{DynamicResource Input.Texto}" Height="32" IsReadOnly="True"
                     Text="{Binding ExportCarpeta}" />
            <Button Content="Elegir…" Style="{DynamicResource Boton.Terciario}" Margin="4,0,0,0"
                    Click="BotonElegirCarpeta_Click" />
          </StackPanel>
          <TextBlock Text="{Binding UltimaExportacionTexto}" Style="{DynamicResource Texto.Caption}"
                     Margin="24,8,0,0" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
